{
  "schemaVersion": 2,
  "fields": [
    {
      "id": "feishu.app-id",
      "serviceId": "feishu",
      "label": "飞书 App ID（应用账号）",
      "type": "text",
      "required": true,
      "secret": false,
      "envVar": "FEISHU_APP_ID",
      "defaultUrl": "",
      "validation": {
        "regex": "^cli_[A-Za-z0-9_-]+$"
      },
      "help": "从飞书开放平台自建应用复制，并在启动 Codex 的同一进程环境中设置 FEISHU_APP_ID。",
      "capabilities": [
        "mcp.feishu"
      ]
    },
    {
      "id": "feishu.app-secret",
      "serviceId": "feishu",
      "label": "飞书 App Secret（应用密码）",
      "type": "secret",
      "required": true,
      "secret": true,
      "envVar": "FEISHU_APP_SECRET",
      "defaultUrl": "",
      "validation": {
        "minLength": 8
      },
      "help": "通过进程环境变量 FEISHU_APP_SECRET 注入；不要写入仓库、config.toml、日志或安装记录。",
      "capabilities": [
        "mcp.feishu"
      ]
    },
    {
      "id": "feishu.base-url",
      "serviceId": "feishu",
      "label": "飞书 API 地址",
      "type": "url",
      "required": false,
      "secret": false,
      "envVar": "FEISHU_DOMAIN",
      "defaultUrl": "https://open.feishu.cn",
      "validation": {
        "scheme": "https",
        "hostAllowlist": [
          "open.feishu.cn",
          "open.larksuite.com"
        ]
      },
      "help": "中国版默认 open.feishu.cn；国际版可选择 open.larksuite.com。",
      "capabilities": [
        "mcp.feishu"
      ]
    },
    {
      "id": "feishu.auth-mode",
      "serviceId": "feishu",
      "label": "认证方式",
      "type": "select",
      "required": false,
      "secret": false,
      "envVar": "FEISHU_AUTH_MODE",
      "defaultUrl": "",
      "validation": {
        "choices": [
          "tenant",
          "user",
          "oauth"
        ]
      },
      "help": "按实际权限选择；user 模式还需 User Access Token，OAuth 模式由官方 CLI 发起授权。文档正文目前只读。",
      "capabilities": [
        "mcp.feishu"
      ]
    },
    {
      "id": "feishu.user-access-token",
      "serviceId": "feishu",
      "label": "飞书 User Access Token（user 模式）",
      "type": "secret",
      "required": false,
      "conditionalRequired": {
        "field": "feishu.auth-mode",
        "equals": "user"
      },
      "secret": true,
      "envVar": "FEISHU_USER_ACCESS_TOKEN",
      "defaultUrl": "",
      "validation": {
        "minLength": 8
      },
      "help": "仅当认证方式选择 user 时填写；留空则无法启用 user 模式。",
      "capabilities": [
        "mcp.feishu"
      ]
    },
    {
      "id": "dashscope.api-key",
      "serviceId": "dashscope-web-search",
      "label": "DashScope API Key",
      "type": "secret",
      "required": true,
      "secret": true,
      "envVar": "DASHSCOPE_API_KEY",
      "defaultUrl": "",
      "validation": {
        "minLength": 20
      },
      "help": "只放本机环境变量或私密凭据存储。",
      "capabilities": [
        "api.dashscope-web-search"
      ]
    },
    {
      "id": "dashscope.base-url",
      "serviceId": "dashscope-web-search",
      "label": "DashScope Base URL",
      "type": "url",
      "required": true,
      "secret": false,
      "envVar": "DASHSCOPE_BASE_URL",
      "defaultUrl": "https://dashscope.aliyuncs.com/compatible-mode/v1",
      "validation": {
        "scheme": "https",
        "path": "/compatible-mode/v1"
      },
      "help": "只填写 compatible-mode/v1 根地址；脚本会自行拼接 /chat/completions。",
      "capabilities": [
        "api.dashscope-web-search"
      ]
    },
    {
      "id": "dashscope.model",
      "serviceId": "dashscope-web-search",
      "label": "DashScope 搜索模型",
      "type": "text",
      "required": true,
      "secret": false,
      "envVar": "DASHSCOPE_MODEL",
      "defaultUrl": "",
      "validation": {
        "minLength": 1
      },
      "help": "设置 DASHSCOPE_MODEL；必须使用服务当前支持且启用联网搜索的模型，不沿用仓库猜测值。",
      "capabilities": [
        "api.dashscope-web-search"
      ]
    },
    {
      "id": "media-generation.agent-id",
      "serviceId": "media-generation",
      "label": "媒体网关路由 ID",
      "type": "text",
      "required": false,
      "secret": false,
      "envVar": "MEDIA_GENERATION_AGENT_ID",
      "defaultUrl": "",
      "validation": {
        "minLength": 1,
        "maxLength": 256
      },
      "help": "仅在服务方要求时填写路由 ID，例如 Seedance 路由；不要用 Codex thread/task ID 替代。",
      "capabilities": [
        "mcp.media-generation"
      ]
    },
    {
      "id": "media-generation.image2-model",
      "serviceId": "media-generation",
      "label": "Image-2 模型名",
      "type": "text",
      "required": false,
      "secret": false,
      "envVar": "MEDIA_IMAGE2_MODEL",
      "defaultUrl": "",
      "validation": {
        "maxLength": 256
      },
      "help": "由安装器从当前上游模型目录自动选择；未发现时保持空白。",
      "capabilities": [
        "mcp.media-generation"
      ]
    },
    {
      "id": "media-generation.grok-image-model",
      "serviceId": "media-generation",
      "label": "Grok 图片模型名",
      "type": "text",
      "required": false,
      "secret": false,
      "envVar": "MEDIA_GROK_IMAGE_MODEL",
      "defaultUrl": "",
      "validation": {
        "maxLength": 256
      },
      "help": "按 API 上游当前支持的模型名填写；不设默认猜测值。",
      "capabilities": [
        "mcp.media-generation"
      ]
    },
    {
      "id": "media-generation.grok-video-model",
      "serviceId": "media-generation",
      "label": "Grok 视频模型名",
      "type": "text",
      "required": false,
      "secret": false,
      "envVar": "MEDIA_GROK_VIDEO_MODEL",
      "defaultUrl": "",
      "validation": {
        "maxLength": 256
      },
      "help": "按 API 上游当前支持的模型名填写；不设默认猜测值。",
      "capabilities": [
        "mcp.media-generation"
      ]
    },
    {
      "id": "media-generation.seedance-model",
      "serviceId": "media-generation",
      "label": "Seedance 视频模型名",
      "type": "text",
      "required": false,
      "secret": false,
      "envVar": "MEDIA_SEEDANCE_MODEL",
      "defaultUrl": "",
      "validation": {
        "maxLength": 256
      },
      "help": "按 API 上游当前支持的模型名填写；不同模型的参数和计费可能不同。",
      "capabilities": [
        "mcp.media-generation"
      ]
    },
    {
      "id": "media-generation.minimax-video-model",
      "serviceId": "media-generation",
      "label": "MiniMax 视频模型名（统一上游可用时填写）",
      "type": "text",
      "required": false,
      "secret": false,
      "envVar": "MEDIA_MINIMAX_VIDEO_MODEL",
      "defaultUrl": "",
      "validation": {
        "maxLength": 256
      },
      "help": "当前留空；仅当同一媒体上游实际开放 MiniMax 模型后填写。自动共用签名 U 盘授权提供的设备 Key，不需另填 Base URL 或 MiniMax 官方 API Key。",
      "capabilities": [
        "mcp.media-generation"
      ]
    }
  ]
}

# Private template only; the USB Codex launcher provides the signed device key and trusted endpoint at startup.
# Do not enter or save the media API key here.
MEDIA_GENERATION_API_PROFILE=responses
# MEDIA_GENERATION_API_BASE_URL and MEDIA_GENERATION_API_KEY are supplied at runtime by the USB launcher.
# Required only by the current Seedance gateway route.
MEDIA_GENERATION_AGENT_ID=
# Image-2 uses the verified Responses API model by default.
MEDIA_IMAGE2_MODEL=gpt-image-2.5
MEDIA_GROK_IMAGE_MODEL=
MEDIA_GROK_VIDEO_MODEL=
MEDIA_SEEDANCE_MODEL=
# Leave blank until the unified upstream exposes a MiniMax video model.
MEDIA_MINIMAX_VIDEO_MODEL=
# Optional. The installer wrapper sets this under the kit's private data directory.
MEDIA_GENERATION_DATA_DIR=

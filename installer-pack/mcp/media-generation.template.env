# Private template only; fill on the target machine. Never commit real credentials.
MEDIA_GENERATION_API_BASE_URL=
# auto selects Wokey for https://api.wokey.ai; set legacy for the 404Token/Sub2API route contract.
MEDIA_GENERATION_API_PROFILE=auto
MEDIA_GENERATION_API_KEY=
# Required by Image-2 and the current Seedance gateway route.
MEDIA_GENERATION_AGENT_ID=
# Enter exact model IDs supplied by the configured upstream; no defaults are guessed.
MEDIA_IMAGE2_MODEL=
MEDIA_GROK_IMAGE_MODEL=
MEDIA_GROK_VIDEO_MODEL=
MEDIA_SEEDANCE_MODEL=
# Leave blank until the unified upstream exposes a MiniMax video model.
MEDIA_MINIMAX_VIDEO_MODEL=
# Optional. The installer wrapper sets this under the kit's private data directory.
MEDIA_GENERATION_DATA_DIR=

# Copy to /etc/codex-usb-license-revocation/service.env and set real key paths/IDs.
USB_REVOCATION_LISTEN_ADDR=127.0.0.1:8787
USB_REVOCATION_DATABASE=/var/lib/codex-usb-license-revocation/state.db
USB_REVOCATION_AUDIT=/var/lib/codex-usb-license-revocation/audit.jsonl
USB_REVOCATION_AUDIT_BACKUP=/var/backups/codex-usb-license-revocation/audit.jsonl
USB_REVOCATION_RESTORE_MARKER=/var/lib/codex-usb-license-revocation/RESTORE-IN-PROGRESS
USB_REVOCATION_LICENSE_KEYRING=/etc/codex-usb-license-revocation/license-keyring.json
USB_REVOCATION_SIGNING_KEY=/etc/codex-usb-license-revocation/status-signing-key
USB_REVOCATION_SIGNING_KEY_ID=replace-before-production
# Set both credentials to enable /admin/. Keep this env file readable only by root/service owner.
# No default account or password is supplied; empty values disable the management console.
USB_REVOCATION_ADMIN_USERNAME=
USB_REVOCATION_ADMIN_PASSWORD=
USB_REVOCATION_ADMIN_AUTH_STATE=/var/lib/codex-usb-license-revocation/admin-auth.json
# Optional pre-provisioned secret. Leave empty to enroll Google Authenticator during the first admin login.
USB_REVOCATION_ADMIN_TOTP_SECRET=
USB_REVOCATION_ADMIN_ORIGIN=https://license.404token.xyz
USB_REVOCATION_ADMIN_COOKIE_SECURE=true
USB_REVOCATION_MAX_RATE_PER_MINUTE=60
USB_REVOCATION_RATE_BURST=10

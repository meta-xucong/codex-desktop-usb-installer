diff --git a/src/lib/model-aliases.ts b/src/lib/model-aliases.ts
new file mode 100644
index 0000000000000000000000000000000000000000..e29671308a292e9d6e377cf0110c9a7f1ab2eeae
--- /dev/null
+++ b/src/lib/model-aliases.ts
@@ -0,0 +1,186 @@
+import type { FetchedModel } from "./api/model-fetch";
+
+export type CollapsedModel = FetchedModel & {
+  /** Text shown in the menu; `id` remains the real upstream request value. */
+  displayName: string;
+};
+
+interface AliasCandidate {
+  id: string;
+  displayName: string;
+  ownedBy: string | null;
+  aliasRank: number;
+  dateValue: number;
+}
+
+function isLeapYear(year: number): boolean {
+  return year % 4 === 0 && (year % 100 !== 0 || year % 400 === 0);
+}
+
+function isValidDate(year: number, month: number, day: number): boolean {
+  if (month < 1 || month > 12 || day < 1) return false;
+  const daysInMonth = [
+    31,
+    isLeapYear(year) ? 29 : 28,
+    31,
+    30,
+    31,
+    30,
+    31,
+    31,
+    30,
+    31,
+    30,
+    31,
+  ];
+  return day <= daysInMonth[month - 1];
+}
+
+type Suffix = { base: string; rank: number; dateValue: number };
+
+function stripReleaseSuffix(id: string): Suffix | null {
+  const lower = id.toLowerCase();
+  if (lower.endsWith("-latest")) {
+    return { base: id.slice(0, -"-latest".length), rank: 2, dateValue: 0 };
+  }
+  if (lower.endsWith("-stable")) {
+    return { base: id.slice(0, -"-stable".length), rank: 1, dateValue: 0 };
+  }
+
+  const isoMatch = id.match(/-(\d{4})-(\d{2})-(\d{2})$/);
+  if (isoMatch) {
+    const year = Number(isoMatch[1]);
+    const month = Number(isoMatch[2]);
+    const day = Number(isoMatch[3]);
+    if (isValidDate(year, month, day)) {
+      return {
+        base: id.slice(0, -isoMatch[0].length),
+        rank: 3,
+        dateValue: year * 10000 + month * 100 + day,
+      };
+    }
+  }
+
+  const compactMatch = id.match(/-(\d{8})$/);
+  if (compactMatch) {
+    const digits = compactMatch[1];
+    const year = Number(digits.slice(0, 4));
+    const month = Number(digits.slice(4, 6));
+    const day = Number(digits.slice(6, 8));
+    if (isValidDate(year, month, day)) {
+      return {
+        base: id.slice(0, -compactMatch[0].length),
+        rank: 3,
+        dateValue: year * 10000 + month * 100 + day,
+      };
+    }
+  }
+  return null;
+}
+
+/** Remove only the explicitly supported release-alias suffixes. */
+export function canonicalModelId(rawId: string): string {
+  let current = rawId.trim();
+  while (true) {
+    const suffix = stripReleaseSuffix(current);
+    if (!suffix || suffix.base.length === 0) return current;
+    current = suffix.base;
+  }
+}
+
+function aliasPreference(rawId: string, displayName: string): Suffix {
+  if (rawId === displayName) {
+    return { base: displayName, rank: 0, dateValue: 0 };
+  }
+  let current = rawId;
+  let best: Suffix | null = null;
+  while (current !== displayName) {
+    const suffix = stripReleaseSuffix(current);
+    if (!suffix) break;
+    if (
+      !best ||
+      suffix.rank < best.rank ||
+      (suffix.rank === best.rank && suffix.dateValue > best.dateValue)
+    ) {
+      best = suffix;
+    }
+    current = suffix.base;
+  }
+  return best ?? { base: displayName, rank: 4, dateValue: 0 };
+}
+
+function compareText(left: string, right: string): number {
+  const a = left.toLowerCase();
+  const b = right.toLowerCase();
+  if (a < b) return -1;
+  if (a > b) return 1;
+  if (left < right) return -1;
+  if (left > right) return 1;
+  return 0;
+}
+
+function compareCandidates(
+  left: AliasCandidate,
+  right: AliasCandidate,
+): number {
+  if (left.aliasRank !== right.aliasRank) {
+    return left.aliasRank - right.aliasRank;
+  }
+  if (left.dateValue !== right.dateValue) {
+    return right.dateValue - left.dateValue;
+  }
+  return compareText(left.id, right.id);
+}
+
+/**
+ * Collapse only release aliases within the same vendor namespace. No vendor
+ * allow-list is used, so newly published GPT, DeepSeek, GLM, Qwen and other
+ * families remain visible; semantically distinct suffixes remain separate.
+ */
+export function collapseReleaseAliases(
+  models: FetchedModel[],
+): CollapsedModel[] {
+  const groups = new Map<string, AliasCandidate[]>();
+
+  for (const model of models) {
+    const id = model.id.trim();
+    if (!id) continue;
+    const ownedBy = model.ownedBy?.trim() || null;
+    const displayName = canonicalModelId(id);
+    const ownerKey = (ownedBy || "Other").toLowerCase();
+    const groupKey = `${ownerKey}\u001f${displayName.toLowerCase()}`;
+    const suffix = aliasPreference(id, displayName);
+    const candidate: AliasCandidate = {
+      id,
+      displayName,
+      ownedBy,
+      aliasRank: suffix.rank,
+      dateValue: suffix.dateValue,
+    };
+    const group = groups.get(groupKey);
+    if (group) group.push(candidate);
+    else groups.set(groupKey, [candidate]);
+  }
+
+  return Array.from(groups.values())
+    .map((candidates) => {
+      candidates.sort(compareCandidates);
+      const selected = candidates[0];
+      return {
+        id: selected.id,
+        displayName: selected.displayName,
+        ownedBy: selected.ownedBy,
+      };
+    })
+    .sort((left, right) => {
+      const owner = compareText(
+        left.ownedBy || "Other",
+        right.ownedBy || "Other",
+      );
+      return (
+        owner ||
+        compareText(left.displayName, right.displayName) ||
+        compareText(left.id, right.id)
+      );
+    });
+}

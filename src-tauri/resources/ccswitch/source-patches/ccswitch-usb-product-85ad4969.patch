--- /dev/null
+++ b/src-tauri/src/usb_model_selection.rs
@@ -0,0 +1,1973 @@
+//! Headless bridge for the USB-bound Codex model selection flow.
+//!
+//! This module is intentionally a narrow configuration bridge. It does not
+//! verify model compatibility, perform network requests, or accept provider
+//! configuration or credentials from the caller. The manager owns the
+//! verification result and any post-switch model catalog.
+
+use crate::app_config::AppType;
+use crate::codex_config::{get_codex_auth_path, get_codex_config_path};
+use crate::database::Database;
+use crate::error::AppError;
+use crate::provider::Provider;
+use crate::services::ProviderService;
+use crate::store::AppState;
+use serde::{Deserialize, Serialize};
+use serde_json::{json, Map, Value};
+use sha2::{Digest, Sha256};
+use std::fs;
+use std::io::{self, Read, Write};
+use std::sync::Arc;
+use std::time::{Duration, Instant};
+use toml_edit::DocumentMut;
+
+const USB_MODEL_SELECTION_FLAG: &str = "--usb-model-selection";
+const MANAGED_MODEL_CATALOG_KEY: &str = "model_catalog_json";
+const MAX_REQUEST_BYTES: usize = 16 * 1024;
+const MAX_RESPONSE_BYTES: usize = 8 * 1024;
+const MAX_CONFIG_BYTES: usize = 4 * 1024 * 1024;
+const MAX_REQUEST_ID_BYTES: usize = 64;
+const MAX_REVISION_BYTES: usize = 128;
+const MAX_MODEL_BYTES: usize = 256;
+const BRIDGE_MAX_LIFETIME: Duration = Duration::from_secs(15);
+
+#[derive(Debug, Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+struct UsbModelSelectionRequest {
+    schema_version: u32,
+    request_id: String,
+    operation: String,
+    binding_fingerprint: String,
+    #[serde(default)]
+    expected_revision: Option<String>,
+    #[serde(default)]
+    model: Option<String>,
+    #[serde(default)]
+    catalog_path: Option<String>,
+    #[serde(default)]
+    catalog_sha256: Option<String>,
+}
+
+#[derive(Debug, Serialize)]
+#[serde(rename_all = "camelCase")]
+struct UsbModelSelectionResponse {
+    schema_version: u32,
+    request_id: String,
+    ok: bool,
+    code: &'static str,
+    revision: Option<String>,
+    selected_model: Option<String>,
+    config_sha256: Option<String>,
+    applied: bool,
+}
+
+struct BridgeSuccess {
+    revision: String,
+    selected_model: Option<String>,
+    config_sha256: Option<String>,
+    applied: bool,
+}
+
+#[derive(Debug)]
+struct BridgeFailure {
+    code: &'static str,
+    revision: Option<String>,
+    selected_model: Option<String>,
+    config_sha256: Option<String>,
+    applied: bool,
+}
+
+impl BridgeFailure {
+    fn new(code: &'static str) -> Self {
+        Self {
+            code,
+            revision: None,
+            selected_model: None,
+            config_sha256: None,
+            applied: false,
+        }
+    }
+
+    fn from_snapshot(snapshot: &UsbModelSelectionSnapshot, code: &'static str) -> Self {
+        Self {
+            code,
+            revision: Some(snapshot.revision.clone()),
+            selected_model: snapshot.selected_model.clone(),
+            config_sha256: snapshot.live.config_sha256.clone(),
+            applied: false,
+        }
+    }
+}
+
+struct BridgeDeadline {
+    deadline: Instant,
+}
+
+impl BridgeDeadline {
+    fn new() -> Self {
+        Self {
+            deadline: Instant::now() + BRIDGE_MAX_LIFETIME,
+        }
+    }
+
+    fn check(&self) -> Result<(), BridgeFailure> {
+        if Instant::now() > self.deadline {
+            Err(BridgeFailure::new("deadline-exceeded"))
+        } else {
+            Ok(())
+        }
+    }
+}
+
+struct LiveConfigSnapshot {
+    config_text: Option<String>,
+    config_sha256: Option<String>,
+    auth_sha256: Option<String>,
+}
+
+struct ConfigInspection {
+    model: Option<String>,
+}
+
+struct UsbModelSelectionSnapshot {
+    provider: Provider,
+    provider_model: Option<String>,
+    live_model: Option<String>,
+    selected_model: Option<String>,
+    live: LiveConfigSnapshot,
+    revision: String,
+    revision_basis: Value,
+}
+
+/// Acquire the cross-process Codex configuration guard.
+///
+/// On non-Windows this is deliberately a no-op: the headless bridge itself is
+/// unsupported there, while ordinary application behavior remains unchanged.
+pub(crate) struct CodexModelSelectionGuard {
+    #[cfg(target_os = "windows")]
+    handle: *mut std::ffi::c_void,
+}
+
+pub(crate) fn acquire_codex_guard() -> Result<CodexModelSelectionGuard, AppError> {
+    #[cfg(target_os = "windows")]
+    {
+        use std::os::windows::ffi::OsStrExt;
+        use std::ptr::null_mut;
+
+        const WAIT_OBJECT_0: u32 = 0x0000_0000;
+        const WAIT_ABANDONED: u32 = 0x0000_0080;
+        const WAIT_TIMEOUT: u32 = 0x0000_0102;
+        const WAIT_MS: u32 = 3_000;
+
+        let name: Vec<u16> = std::ffi::OsStr::new("Local\\CodexUsbModelSelection")
+            .encode_wide()
+            .chain(std::iter::once(0))
+            .collect();
+        let handle = unsafe { CreateMutexW(null_mut(), 0, name.as_ptr()) };
+        if handle.is_null() {
+            return Err(AppError::Lock("USB Codex mutex creation failed".into()));
+        }
+
+        let wait_result = unsafe { WaitForSingleObject(handle, WAIT_MS) };
+        if wait_result != WAIT_OBJECT_0 {
+            unsafe {
+                if wait_result == WAIT_ABANDONED {
+                    ReleaseMutex(handle);
+                }
+                CloseHandle(handle);
+            }
+            let message = if wait_result == WAIT_TIMEOUT {
+                "USB Codex mutex wait timed out"
+            } else {
+                "USB Codex mutex wait failed"
+            };
+            return Err(AppError::Lock(message.into()));
+        }
+
+        Ok(CodexModelSelectionGuard { handle })
+    }
+
+    #[cfg(not(target_os = "windows"))]
+    {
+        Ok(CodexModelSelectionGuard {})
+    }
+}
+
+impl Drop for CodexModelSelectionGuard {
+    fn drop(&mut self) {
+        #[cfg(target_os = "windows")]
+        if !self.handle.is_null() {
+            // A Windows mutex is recursive for the owning thread. Each
+            // nested service/DAO guard therefore releases exactly one level.
+            unsafe {
+                ReleaseMutex(self.handle);
+                CloseHandle(self.handle);
+            }
+        }
+    }
+}
+
+#[cfg(target_os = "windows")]
+#[link(name = "kernel32")]
+unsafe extern "system" {
+    fn CreateMutexW(
+        lp_mutex_attributes: *mut std::ffi::c_void,
+        b_initial_owner: i32,
+        lp_name: *const u16,
+    ) -> *mut std::ffi::c_void;
+    fn WaitForSingleObject(handle: *mut std::ffi::c_void, milliseconds: u32) -> u32;
+    fn ReleaseMutex(handle: *mut std::ffi::c_void) -> i32;
+    fn CloseHandle(handle: *mut std::ffi::c_void) -> i32;
+}
+
+/// Run the USB model-selection bridge when, and only when, the process was
+/// invoked with exactly --usb-model-selection.
+pub fn try_usb_model_selection_cli() -> Option<i32> {
+    if !is_usb_model_selection_invocation() {
+        return None;
+    }
+
+    let response = match read_request_bytes() {
+        Ok(bytes) => match parse_request(&bytes) {
+            Ok(request) => execute_request(&request),
+            Err(_) => response_for_failure("", BridgeFailure::new("invalid-request")),
+        },
+        Err(code) => response_for_failure("", BridgeFailure::new(code)),
+    };
+
+    let exit_code = if response.ok { 0 } else { 1 };
+    if write_response(&response) {
+        Some(exit_code)
+    } else {
+        Some(1)
+    }
+}
+
+fn is_usb_model_selection_invocation() -> bool {
+    let mut args = std::env::args_os();
+    let _program = args.next();
+    matches!(
+        (args.next(), args.next()),
+        (Some(flag), None) if flag == std::ffi::OsStr::new(USB_MODEL_SELECTION_FLAG)
+    )
+}
+
+fn read_request_bytes() -> Result<Vec<u8>, &'static str> {
+    let mut input = Vec::new();
+    io::stdin()
+        .lock()
+        .take((MAX_REQUEST_BYTES + 1) as u64)
+        .read_to_end(&mut input)
+        .map_err(|_| "stdin-read-failed")?;
+    if input.len() > MAX_REQUEST_BYTES {
+        return Err("request-too-large");
+    }
+    Ok(input)
+}
+
+fn parse_request(bytes: &[u8]) -> Result<UsbModelSelectionRequest, &'static str> {
+    let request: UsbModelSelectionRequest =
+        serde_json::from_slice(bytes).map_err(|_| "invalid-request")?;
+    if request.schema_version != 3
+        || !is_safe_request_id(&request.request_id)
+        || request.binding_fingerprint.len() != 64
+        || !request
+            .binding_fingerprint
+            .bytes()
+            .all(|b| b.is_ascii_hexdigit())
+        || !matches!(request.operation.as_str(), "snapshot" | "apply")
+    {
+        return Err("invalid-request");
+    }
+    if let Some(revision) = request.expected_revision.as_deref() {
+        validate_bounded_text(revision, MAX_REVISION_BYTES).map_err(|_| "invalid-request")?;
+    }
+    if let Some(model) = request.model.as_deref() {
+        validate_bounded_text(model, MAX_MODEL_BYTES).map_err(|_| "invalid-request")?;
+    }
+    if request.operation == "apply" {
+        let path = request.catalog_path.as_deref().ok_or("invalid-request")?;
+        validate_bounded_text(path, 4096).map_err(|_| "invalid-request")?;
+        let hash = request.catalog_sha256.as_deref().ok_or("invalid-request")?;
+        if hash.len() != 64 || !hash.bytes().all(|b| b.is_ascii_hexdigit()) {
+            return Err("invalid-request");
+        }
+    } else if request.catalog_path.is_some() || request.catalog_sha256.is_some() {
+        return Err("invalid-request");
+    }
+    Ok(request)
+}
+
+fn is_safe_request_id(request_id: &str) -> bool {
+    !request_id.is_empty()
+        && request_id.len() <= MAX_REQUEST_ID_BYTES
+        && request_id
+            .bytes()
+            .all(|byte| byte.is_ascii_alphanumeric() || matches!(byte, b'-' | b'_' | b'.' | b':'))
+}
+
+fn validate_bounded_text(value: &str, max_bytes: usize) -> Result<(), ()> {
+    if value.is_empty() || value.len() > max_bytes || value.chars().any(char::is_control) {
+        Err(())
+    } else {
+        Ok(())
+    }
+}
+
+// Consistency metadata only: the signed-license/native readiness decision
+// belongs to the manager. This helper never issues capability certificates.
+fn selection_binding_fingerprint(
+    provider: &str,
+    account: &str,
+    credential: &str,
+    group: u64,
+    user: u64,
+) -> Result<String, BridgeFailure> {
+    if provider != crate::services::provider::USB_404TOKEN_PROVIDER_ID
+        || group == 0
+        || user == 0
+        || validate_bounded_text(account, 1024).is_err()
+        || validate_bounded_text(credential, 1024).is_err()
+        || !account
+            .strip_prefix("USB-")
+            .is_some_and(|s| !s.is_empty() && s.bytes().all(|b| b.is_ascii_digit()))
+    {
+        return Err(BridgeFailure::new("binding-context-mismatch"));
+    }
+    let bytes = serde_json::to_vec(&(provider, account, credential, group, user))
+        .map_err(|_| BridgeFailure::new("binding-context-mismatch"))?;
+    Ok(sha256_hex(&bytes))
+}
+
+#[cfg(target_os = "windows")]
+fn environment_binding_fingerprint() -> Result<String, BridgeFailure> {
+    let required =
+        |name| std::env::var(name).map_err(|_| BridgeFailure::new("binding-context-missing"));
+    let provider = required("CCSWITCH_404TOKEN_PROVIDER")?;
+    let account = required("CCSWITCH_404TOKEN_ACCOUNT")?;
+    let credential = required("CCSWITCH_404TOKEN_CREDENTIAL_ID")?;
+    let group = required("CCSWITCH_404TOKEN_GROUP_ID")?
+        .parse::<u64>()
+        .map_err(|_| BridgeFailure::new("binding-context-mismatch"))?;
+    let user = required("CCSWITCH_404TOKEN_USER_ID")?
+        .parse::<u64>()
+        .map_err(|_| BridgeFailure::new("binding-context-mismatch"))?;
+    selection_binding_fingerprint(&provider, &account, &credential, group, user)
+}
+
+fn execute_request(request: &UsbModelSelectionRequest) -> UsbModelSelectionResponse {
+    #[cfg(not(target_os = "windows"))]
+    {
+        return response_for_failure(
+            &request.request_id,
+            BridgeFailure::new("unsupported-platform"),
+        );
+    }
+
+    #[cfg(target_os = "windows")]
+    {
+        let result = execute_request_windows(request);
+        match result {
+            Ok(success) => UsbModelSelectionResponse {
+                schema_version: 3,
+                request_id: request.request_id.clone(),
+                ok: true,
+                code: "ok",
+                revision: Some(success.revision),
+                selected_model: success.selected_model,
+                config_sha256: success.config_sha256,
+                applied: success.applied,
+            },
+            Err(failure) => response_for_failure(&request.request_id, failure),
+        }
+    }
+}
+
+#[cfg(target_os = "windows")]
+fn execute_request_windows(
+    request: &UsbModelSelectionRequest,
+) -> Result<BridgeSuccess, BridgeFailure> {
+    let deadline = BridgeDeadline::new();
+    if environment_binding_fingerprint()? != request.binding_fingerprint {
+        return Err(BridgeFailure::new("binding-context-mismatch"));
+    }
+    let _bridge_guard = acquire_codex_guard().map_err(|_| BridgeFailure::new("lock-failed"))?;
+    deadline.check()?;
+    // Refuse the ordinary/shared CC Switch store before any DB initialization.
+    if std::env::var("CODEX_USB_CCSWITCH_MODE").ok().as_deref() != Some("usb")
+        || crate::config::usb_app_config_dir().is_none()
+    {
+        return Err(BridgeFailure::new("codex-home-conflict"));
+    }
+    let expected_home = validate_expected_codex_home()?;
+    let usb_home = std::env::var_os("CCSWITCH_USB_CODEX_HOME")
+        .map(std::path::PathBuf::from)
+        .ok_or_else(|| BridgeFailure::new("codex-home-conflict"))?;
+    reject_reparse_ancestors(&usb_home)?;
+    if fs::canonicalize(&usb_home).ok().as_ref() != Some(&expected_home) {
+        return Err(BridgeFailure::new("codex-home-conflict"));
+    }
+
+    let db = Database::init().map_err(|_| BridgeFailure::new("database-init-failed"))?;
+    let state = AppState::new(Arc::new(db));
+    deadline.check()?;
+
+    let prepared = ProviderService::bootstrap_usb_404token_from_environment(&state)
+        .map_err(|_| BridgeFailure::new("bootstrap-failed"))?;
+    if !prepared {
+        return Err(BridgeFailure::new("device-key-missing"));
+    }
+    deadline.check()?;
+
+    match request.operation.as_str() {
+        "snapshot" => execute_snapshot(&state, &deadline),
+        "apply" => execute_apply(&state, request, &deadline),
+        _ => Err(BridgeFailure::new("invalid-request")),
+    }
+}
+
+#[cfg(target_os = "windows")]
+fn execute_snapshot(
+    state: &AppState,
+    deadline: &BridgeDeadline,
+) -> Result<BridgeSuccess, BridgeFailure> {
+    let snapshot = load_usb_snapshot(state)?;
+    deadline.check()?;
+    Ok(BridgeSuccess {
+        revision: snapshot.revision,
+        selected_model: snapshot.selected_model,
+        config_sha256: snapshot.live.config_sha256,
+        applied: false,
+    })
+}
+
+#[cfg(target_os = "windows")]
+fn restore_live_file(
+    path: &std::path::Path,
+    before: &Option<Vec<u8>>,
+    written: &[u8],
+) -> Result<(), BridgeFailure> {
+    let current = bounded_regular_bytes(path)?;
+    if &current == before {
+        return Ok(());
+    }
+    if current.as_deref() != Some(written) {
+        return Err(BridgeFailure::new("rollback-conflict"));
+    }
+    match before {
+        Some(bytes) => crate::config::atomic_write_private(path, bytes),
+        None => crate::config::delete_file(path),
+    }
+    .map_err(|_| BridgeFailure::new("rollback-incomplete"))
+}
+
+#[cfg(target_os = "windows")]
+fn requested_catalog(
+    request: &UsbModelSelectionRequest,
+    model: &str,
+) -> Result<String, BridgeFailure> {
+    let path = request
+        .catalog_path
+        .as_deref()
+        .ok_or_else(|| BridgeFailure::new("catalog-required"))?;
+    validate_owned_catalog(path)?;
+    let bytes = bounded_regular_bytes(std::path::Path::new(path))?
+        .ok_or_else(|| BridgeFailure::new("catalog-conflict"))?;
+    if request.catalog_sha256.as_deref() != Some(sha256_hex(&bytes).as_str()) {
+        return Err(BridgeFailure::new("catalog-revision-mismatch"));
+    }
+    let value: Value =
+        serde_json::from_slice(&bytes).map_err(|_| BridgeFailure::new("catalog-conflict"))?;
+    let models = value
+        .get("models")
+        .and_then(Value::as_array)
+        .ok_or_else(|| BridgeFailure::new("catalog-conflict"))?;
+    if models
+        .iter()
+        .filter(|m| m.get("slug").and_then(Value::as_str) == Some(model))
+        .count()
+        != 1
+    {
+        return Err(BridgeFailure::new("catalog-model-conflict"));
+    }
+    Ok(path.into())
+}
+
+/// Ephemeral native-writer input. The catalog digest is a race fence, NOT a
+/// persisted trust proof or renewed model certification (owned by the manager).
+pub(crate) struct UsbBootstrapProjection {
+    pub(crate) provider: Provider,
+    config_path: std::path::PathBuf,
+    config_before: Option<Vec<u8>>,
+    catalog: Option<(std::path::PathBuf, String, String)>,
+}
+
+fn bootstrap_preservation_error() -> AppError {
+    AppError::Config(
+        "USB model/catalog preservation conflict; original configuration retained".into(),
+    )
+}
+
+fn bootstrap_regular_bytes(path: &std::path::Path) -> Result<Option<Vec<u8>>, AppError> {
+    for ancestor in path.ancestors() {
+        match fs::symlink_metadata(ancestor) {
+            Ok(meta) => {
+                if meta.file_type().is_symlink() {
+                    return Err(bootstrap_preservation_error());
+                }
+                #[cfg(windows)]
+                {
+                    use std::os::windows::fs::MetadataExt;
+                    if meta.file_attributes() & 0x400 != 0 {
+                        return Err(bootstrap_preservation_error());
+                    }
+                }
+            }
+            Err(e) if e.kind() == io::ErrorKind::NotFound => {}
+            Err(_) => return Err(bootstrap_preservation_error()),
+        }
+    }
+    let meta = match fs::symlink_metadata(path) {
+        Ok(meta) => meta,
+        Err(e) if e.kind() == io::ErrorKind::NotFound => return Ok(None),
+        Err(_) => return Err(bootstrap_preservation_error()),
+    };
+    if !meta.is_file() || meta.len() > MAX_CONFIG_BYTES as u64 {
+        return Err(bootstrap_preservation_error());
+    }
+    let mut bytes = Vec::new();
+    fs::File::open(path)
+        .map_err(|_| bootstrap_preservation_error())?
+        .take((MAX_CONFIG_BYTES + 1) as u64)
+        .read_to_end(&mut bytes)
+        .map_err(|_| bootstrap_preservation_error())?;
+    if bytes.len() > MAX_CONFIG_BYTES {
+        return Err(bootstrap_preservation_error());
+    }
+    Ok(Some(bytes))
+}
+
+fn bootstrap_model(doc: &DocumentMut) -> Result<Option<String>, AppError> {
+    match doc.get("model") {
+        None => Ok(None),
+        Some(item) => {
+            let model = item
+                .as_str()
+                .ok_or_else(bootstrap_preservation_error)?
+                .trim();
+            if model.is_empty() {
+                return Ok(None);
+            }
+            validate_bounded_text(model, MAX_MODEL_BYTES)
+                .map_err(|_| bootstrap_preservation_error())?;
+            Ok(Some(model.into()))
+        }
+    }
+}
+
+/// Require the exact manager-owned block, not an arbitrary user pointer.
+fn bootstrap_owned_pointer(text: &str, pointer: &str) -> Result<(), AppError> {
+    const BEGIN: &str = "# BEGIN CODEX-USB-NATIVE-MODEL-CATALOG v1";
+    const END: &str = "# END CODEX-USB-NATIVE-MODEL-CATALOG v1";
+    let expected = format!(
+        "model_catalog_json = {}",
+        serde_json::to_string(pointer).map_err(|_| bootstrap_preservation_error())?
+    );
+    let mut inside = false;
+    let mut seen = false;
+    let mut count = 0;
+    for line in text.lines().map(str::trim) {
+        if line == BEGIN {
+            if inside || seen {
+                return Err(bootstrap_preservation_error());
+            }
+            inside = true;
+            seen = true;
+        } else if line == END {
+            if !inside {
+                return Err(bootstrap_preservation_error());
+            }
+            inside = false;
+        } else if inside && !line.is_empty() && !line.starts_with('#') {
+            if line != expected {
+                return Err(bootstrap_preservation_error());
+            }
+            count += 1;
+        }
+    }
+    if inside || !seen || count != 1 {
+        return Err(bootstrap_preservation_error());
+    }
+    // Reuse the production leaf validator to reject string-data markers and
+    // structurally modified blocks without applying the returned bytes.
+    use crate::live::patch::LivePatch;
+    model_catalog_patch("validation-only", pointer)
+        .apply(std::path::Path::new("config.toml"), Some(text.as_bytes()))
+        .map_err(|_| bootstrap_preservation_error())?;
+    Ok(())
+}
+
+pub(crate) fn prepare_usb_bootstrap_projection(
+    provider: &Provider,
+) -> Result<UsbBootstrapProjection, AppError> {
+    let home = crate::config::usb_codex_home_for_mode(
+        std::env::var("CODEX_USB_CCSWITCH_MODE").ok().as_deref(),
+        std::env::var_os("CCSWITCH_USB_CODEX_HOME").as_deref(),
+    )
+    .ok_or_else(bootstrap_preservation_error)?;
+    prepare_usb_bootstrap_projection_at(provider, &home, &get_codex_config_path())
+}
+
+fn prepare_usb_bootstrap_projection_at(
+    provider: &Provider,
+    home: &std::path::Path,
+    config_path: &std::path::Path,
+) -> Result<UsbBootstrapProjection, AppError> {
+    let before = bootstrap_regular_bytes(config_path)?;
+    // A brand-new USB profile has no directory yet. Create only that empty
+    // directory; never invent a config/auth file. Recheck all ancestors after.
+    if before.is_none() && !home.exists() {
+        fs::create_dir_all(home).map_err(|_| bootstrap_preservation_error())?;
+        if bootstrap_regular_bytes(config_path)?.is_some() {
+            return Err(bootstrap_preservation_error());
+        }
+    }
+    // Checking config and catalog ancestors also rejects a reparse home.
+    let canonical_home = fs::canonicalize(home).map_err(|_| bootstrap_preservation_error())?;
+    if config_path
+        .parent()
+        .and_then(|p| fs::canonicalize(p).ok())
+        .as_ref()
+        != Some(&canonical_home)
+    {
+        return Err(bootstrap_preservation_error());
+    }
+    let live_text = match before.as_deref() {
+        Some(bytes) => std::str::from_utf8(bytes).map_err(|_| bootstrap_preservation_error())?,
+        None => "",
+    };
+    let live: DocumentMut = live_text
+        .parse()
+        .map_err(|_| bootstrap_preservation_error())?;
+    let row_text = provider
+        .settings_config
+        .get("config")
+        .and_then(Value::as_str)
+        .ok_or_else(bootstrap_preservation_error)?;
+    let mut row: DocumentMut = row_text
+        .parse()
+        .map_err(|_| bootstrap_preservation_error())?;
+    let live_model = bootstrap_model(&live)?;
+    let _row_model = bootstrap_model(&row)?;
+    // Bootstrap follows the live Codex selection. Provider rows can be new,
+    // stale, or absent on first install, so never let their model override it.
+    if let Some(model) = live_model.as_deref() {
+        row["model"] = toml_edit::value(model);
+    } else {
+        row.remove("model");
+    }
+    // Preserve only native model/reasoning floor leaves, never route/auth or
+    // arbitrary snapshots. Existing live choices are not re-certified here.
+    let mut paths = vec![
+        vec!["review_model"],
+        vec!["model_reasoning_effort"],
+        vec!["plan_mode_reasoning_effort"],
+    ];
+    paths.extend(
+        crate::live::floor::CODEX_FLOOR_NESTED
+            .iter()
+            .map(|path| path.to_vec()),
+    );
+    for path in paths {
+        let lookup = |doc: &DocumentMut| -> Result<Option<String>, AppError> {
+            let mut value = doc.as_item();
+            for key in &path {
+                let Some(next) = value.get(*key) else {
+                    return Ok(None);
+                };
+                value = next;
+            }
+            let value = value.as_str().ok_or_else(bootstrap_preservation_error)?;
+            validate_bounded_text(value, MAX_MODEL_BYTES)
+                .map_err(|_| bootstrap_preservation_error())?;
+            Ok(Some(value.to_owned()))
+        };
+        let _old = lookup(&row)?;
+        let current = lookup(&live)?;
+        if let Some(current) = current {
+            if path.len() == 1 {
+                row[path[0]] = toml_edit::value(current);
+            } else {
+                if row.get(path[0]).is_none() {
+                    row[path[0]] = toml_edit::Item::Table(toml_edit::Table::new());
+                }
+                let table = row[path[0]]
+                    .as_table_like_mut()
+                    .ok_or_else(bootstrap_preservation_error)?;
+                table.insert(path[1], toml_edit::value(current));
+            }
+        } else if path.len() == 1 {
+            row.remove(path[0]);
+        } else if let Some(table) = row.get_mut(path[0]).and_then(|v| v.as_table_like_mut()) {
+            table.remove(path[1]);
+        }
+    }
+    // Old rows may contain stale machine paths; never resurrect them.
+    row.remove(MANAGED_MODEL_CATALOG_KEY);
+    let catalog = if let Some(pointer) = live.get(MANAGED_MODEL_CATALOG_KEY) {
+        let pointer = pointer.as_str().ok_or_else(bootstrap_preservation_error)?;
+        bootstrap_owned_pointer(live_text, pointer)?;
+        let path = std::path::PathBuf::from(pointer);
+        let expected = canonical_home.join("codex-usb-native-model-catalog.json");
+        if !path.is_absolute() || path.file_name() != expected.file_name() {
+            return Err(bootstrap_preservation_error());
+        }
+        let bytes = bootstrap_regular_bytes(&path)?.ok_or_else(bootstrap_preservation_error)?;
+        if fs::canonicalize(&path).ok().as_ref() != Some(&expected) {
+            return Err(bootstrap_preservation_error());
+        }
+        let value: Value =
+            serde_json::from_slice(&bytes).map_err(|_| bootstrap_preservation_error())?;
+        if value.get("identity").and_then(Value::as_str) != Some("404token-unified-api-internal")
+            || value.get("schema_version").and_then(Value::as_u64) != Some(1)
+        {
+            return Err(bootstrap_preservation_error());
+        }
+        let models = value
+            .get("models")
+            .and_then(Value::as_array)
+            .filter(|v| v.len() <= 512)
+            .ok_or_else(bootstrap_preservation_error)?;
+        let mut ids = std::collections::HashSet::new();
+        for model in models {
+            let id = model
+                .get("slug")
+                .and_then(Value::as_str)
+                .ok_or_else(bootstrap_preservation_error)?;
+            validate_bounded_text(id, MAX_MODEL_BYTES)
+                .map_err(|_| bootstrap_preservation_error())?;
+            if id.chars().any(char::is_whitespace) || !ids.insert(id) {
+                return Err(bootstrap_preservation_error());
+            }
+        }
+        let selected = live_model
+            .as_deref()
+            .ok_or_else(bootstrap_preservation_error)?;
+        if !ids.contains(selected) {
+            return Err(bootstrap_preservation_error());
+        }
+        row[MANAGED_MODEL_CATALOG_KEY] = live[MANAGED_MODEL_CATALOG_KEY].clone();
+        Some((path, sha256_hex(&bytes), pointer.to_owned()))
+    } else {
+        if live_text.lines().any(|line| {
+            matches!(
+                line.trim(),
+                "# BEGIN CODEX-USB-NATIVE-MODEL-CATALOG v1"
+                    | "# END CODEX-USB-NATIVE-MODEL-CATALOG v1"
+            )
+        }) {
+            return Err(bootstrap_preservation_error());
+        }
+        None
+    };
+    let mut ephemeral = provider.clone();
+    let settings = ephemeral
+        .settings_config
+        .as_object_mut()
+        .ok_or_else(bootstrap_preservation_error)?;
+    settings.remove(MANAGED_MODEL_CATALOG_KEY);
+    settings.insert("config".into(), Value::String(row.to_string()));
+    Ok(UsbBootstrapProjection {
+        provider: ephemeral,
+        config_path: config_path.into(),
+        config_before: before,
+        catalog,
+    })
+}
+
+impl UsbBootstrapProjection {
+    fn verify_catalog(&self) -> Result<(), AppError> {
+        if let Some((path, hash, _)) = &self.catalog {
+            let bytes = bootstrap_regular_bytes(path)?.ok_or_else(bootstrap_preservation_error)?;
+            if sha256_hex(&bytes) != *hash {
+                return Err(bootstrap_preservation_error());
+            }
+        }
+        Ok(())
+    }
+    pub(crate) fn verify_before_write(&self) -> Result<(), AppError> {
+        if bootstrap_regular_bytes(&self.config_path)? != self.config_before {
+            return Err(bootstrap_preservation_error());
+        }
+        self.verify_catalog()
+    }
+    pub(crate) fn verify_after_write(&self) -> Result<(), AppError> {
+        self.verify_catalog()?;
+        if let Some((_, _, pointer)) = &self.catalog {
+            let bytes = bootstrap_regular_bytes(&self.config_path)?
+                .ok_or_else(bootstrap_preservation_error)?;
+            let text = std::str::from_utf8(&bytes).map_err(|_| bootstrap_preservation_error())?;
+            let doc: DocumentMut = text.parse().map_err(|_| bootstrap_preservation_error())?;
+            if doc.get(MANAGED_MODEL_CATALOG_KEY).and_then(|v| v.as_str()) != Some(pointer.as_str())
+            {
+                return Err(bootstrap_preservation_error());
+            }
+            bootstrap_owned_pointer(text, pointer)?;
+        }
+        Ok(())
+    }
+}
+
+/// A leaf-only patch using the official TOML patcher, plus the manager's
+/// existing ownership comments required by reset/reattach. Never projects a
+/// provider snapshot or writes credentials/auth.json.
+struct UsbModelCatalogPatch {
+    model: String,
+    catalog: String,
+}
+
+fn model_catalog_patch(model: &str, catalog: &str) -> UsbModelCatalogPatch {
+    UsbModelCatalogPatch {
+        model: model.into(),
+        catalog: catalog.into(),
+    }
+}
+
+impl crate::live::patch::LivePatch for UsbModelCatalogPatch {
+    fn apply(
+        &self,
+        path: &std::path::Path,
+        pre: Option<&[u8]>,
+    ) -> Result<Vec<u8>, crate::live::patch::LiveWriteError> {
+        use crate::live::patch::{KeyPath, LiveWriteError};
+        const BEGIN: &str = "# BEGIN CODEX-USB-NATIVE-MODEL-CATALOG v1";
+        const END: &str = "# END CODEX-USB-NATIVE-MODEL-CATALOG v1";
+        let source = crate::live::patch::toml::parse(path, pre)?;
+        let text = source.to_string();
+        let mut inside = false;
+        let mut seen = false;
+        let conflict = || LiveWriteError::Conflict {
+            path: path.to_path_buf(),
+        };
+        // Marker lines inside a multiline TOML string are user data, not
+        // ownership comments. Refuse rather than stripping their contents.
+        fn contains_marker_data(value: &toml::Value) -> bool {
+            match value {
+                toml::Value::String(value) => {
+                    value.lines().any(|line| matches!(line.trim(), BEGIN | END))
+                }
+                toml::Value::Array(values) => values.iter().any(contains_marker_data),
+                toml::Value::Table(values) => values.values().any(contains_marker_data),
+                _ => false,
+            }
+        }
+        let values: toml::Value = text.parse().map_err(|_| conflict())?;
+        if contains_marker_data(&values) {
+            return Err(conflict());
+        }
+        // Refuse malformed ownership blocks or user settings inserted inside
+        // one; never silently treat them as disposable installer content.
+        for line in text.lines() {
+            let line = line.trim();
+            if line == BEGIN {
+                if inside || seen {
+                    return Err(conflict());
+                }
+                inside = true;
+                seen = true;
+            } else if line == END {
+                if !inside {
+                    return Err(conflict());
+                }
+                inside = false;
+            } else if inside
+                && !line.is_empty()
+                && !line.starts_with('#')
+                && !line
+                    .strip_prefix(MANAGED_MODEL_CATALOG_KEY)
+                    .is_some_and(|rest| rest.trim_start().starts_with('='))
+            {
+                return Err(conflict());
+            }
+        }
+        if inside {
+            return Err(conflict());
+        }
+        let patch = crate::live::patch::toml::TomlPatch {
+            remove: vec![KeyPath::new(&[MANAGED_MODEL_CATALOG_KEY])],
+            set: vec![(
+                KeyPath::new(&["model"]),
+                toml_edit::value(self.model.as_str()),
+            )],
+            ..Default::default()
+        };
+        let patched = patch.apply(path, pre)?;
+        let patched = std::str::from_utf8(&patched).map_err(|_| conflict())?;
+        let body = patched
+            .split_inclusive('\n')
+            .filter(|line| !matches!(line.trim(), BEGIN | END))
+            .collect::<String>();
+        // Match the manager's exact basic-string encoding for reset/reattach.
+        let pointer = serde_json::to_string(&self.catalog).map_err(|_| conflict())?;
+        let output = format!(
+            "{BEGIN}\n{MANAGED_MODEL_CATALOG_KEY} = {pointer}\n{END}\n\n{}",
+            body.trim_start_matches(['\r', '\n'])
+        );
+        crate::live::patch::toml::parse(path, Some(output.as_bytes()))?;
+        Ok(output.into_bytes())
+    }
+}
+
+#[cfg(target_os = "windows")]
+fn execute_apply(
+    state: &AppState,
+    request: &UsbModelSelectionRequest,
+    deadline: &BridgeDeadline,
+) -> Result<BridgeSuccess, BridgeFailure> {
+    let requested_model = request
+        .model
+        .as_deref()
+        .ok_or_else(|| BridgeFailure::new("model-required"))?
+        .trim()
+        .to_string();
+    validate_bounded_text(&requested_model, MAX_MODEL_BYTES)
+        .map_err(|_| BridgeFailure::new("model-invalid"))?;
+
+    let expected_revision = request
+        .expected_revision
+        .as_deref()
+        .ok_or_else(|| BridgeFailure::new("revision-required"))?;
+    let snapshot = load_usb_snapshot(state)?;
+    if expected_revision != snapshot.revision {
+        return Err(BridgeFailure::from_snapshot(&snapshot, "revision-mismatch"));
+    }
+
+    if snapshot
+        .provider_model
+        .as_deref()
+        .is_some_and(|model| model != requested_model.as_str())
+        || snapshot
+            .live_model
+            .as_deref()
+            .is_some_and(|model| model != requested_model.as_str())
+    {
+        return Err(BridgeFailure::from_snapshot(
+            &snapshot,
+            "user-model-conflict",
+        ));
+    }
+
+    reject_proxy_takeover(state)?;
+    deadline.check()?;
+    // The official writer lock serializes this leaf-only operation with 4.x
+    // provider/mode writes. The outer USB mutex also fences manager processes.
+    let _live_guard = crate::live::engine::lock_app(AppType::Codex.as_str());
+    reject_proxy_takeover(state)?;
+    let current_snapshot = load_usb_snapshot(state)?;
+    if current_snapshot.revision != snapshot.revision {
+        return Err(BridgeFailure::from_snapshot(
+            &current_snapshot,
+            "revision-mismatch",
+        ));
+    }
+    let updated_provider =
+        provider_with_selected_model(&current_snapshot.provider, None, &requested_model)?;
+    let catalog_path = requested_catalog(request, &requested_model)?;
+    let patch = model_catalog_patch(&requested_model, &catalog_path);
+    let config_path = get_codex_config_path();
+    let auth_path = get_codex_auth_path();
+    let before_config = bounded_regular_bytes(&config_path)?;
+    let before_auth = bounded_regular_bytes(&auth_path)?;
+    if before_config.as_ref().map(|v| sha256_hex(v)) != current_snapshot.live.config_sha256
+        || before_auth.as_ref().map(|v| sha256_hex(v)) != current_snapshot.live.auth_sha256
+    {
+        return Err(BridgeFailure::new("revision-mismatch"));
+    }
+    use crate::live::patch::LivePatch;
+    let intended_config = patch
+        .apply(&config_path, before_config.as_deref())
+        .map_err(|_| BridgeFailure::new("provider-config-invalid"))?;
+    let db_current = current_snapshot
+        .revision_basis
+        .get("databaseCurrentProvider")
+        .and_then(Value::as_str);
+    let settings_current = crate::mode::current::local_direct_pointer(&AppType::Codex);
+    if db_current.is_some_and(|id| id != crate::services::provider::USB_404TOKEN_PROVIDER_ID)
+        || settings_current
+            .as_deref()
+            .is_some_and(|id| id != crate::services::provider::USB_404TOKEN_PROVIDER_ID)
+    {
+        return Err(BridgeFailure::new("user-provider-conflict"));
+    }
+    let mut written_hash = None;
+    // This legacy USB-specific row+file transaction is not the v4 mode journal:
+    // a crash after rename but before SQLite commit can leave live/row drift.
+    // Conflicting explicit models fail closed; a formerly absent row model
+    // cannot distinguish this crash from a user's live model edit. No crash
+    // recovery or multi-file atomicity is claimed by this helper.
+    let transaction = state.db.apply_usb_model_selection_transaction(
+        &current_snapshot.provider.settings_config,
+        &updated_provider.settings_config,
+        db_current,
+        || {
+            let safe = || AppError::Config("USB selection live configuration changed".into());
+            deadline.check().map_err(|_| safe())?;
+            if bounded_regular_bytes(&config_path).map_err(|_| safe())? != before_config
+                || bounded_regular_bytes(&auth_path).map_err(|_| safe())? != before_auth
+                || crate::mode::current::local_direct_pointer(&AppType::Codex) != settings_current
+            {
+                return Err(safe());
+            }
+            let file = crate::live::engine::LiveFile::private(&config_path);
+            let planned = crate::live::engine::plan(&file, &patch)?;
+            if planned.pre != current_snapshot.live.config_sha256 {
+                return Err(safe());
+            }
+            crate::live::engine::ensure_first_write_backup(
+                &crate::live::engine::DeviceStore::for_device(),
+                &config_path,
+                before_config.as_deref(),
+            )?;
+            let staged = crate::live::engine::stage(&planned)?;
+            let precondition = (|| {
+                if bounded_regular_bytes(&config_path).map_err(|_| safe())? != before_config
+                    || bounded_regular_bytes(&auth_path).map_err(|_| safe())? != before_auth
+                {
+                    return Err(safe());
+                }
+                Ok(())
+            })();
+            if let Err(error) = precondition {
+                if let Some(staged) = staged {
+                    let _ = fs::remove_file(staged.tmp_path());
+                }
+                return Err(error);
+            }
+            if let Some(staged) = staged {
+                staged.commit()?;
+            }
+            let actual_config = bounded_regular_bytes(&config_path)
+                .map_err(|_| safe())?
+                .ok_or_else(safe)?;
+            if actual_config != intended_config
+                || bounded_regular_bytes(&auth_path).map_err(|_| safe())? != before_auth
+                || crate::mode::current::local_direct_pointer(&AppType::Codex) != settings_current
+            {
+                return Err(safe());
+            }
+            deadline.check().map_err(|_| safe())?;
+            written_hash = Some(sha256_hex(&actual_config));
+            Ok(())
+        },
+    );
+    if transaction.is_err() {
+        // Do not restore auth: the 4.x USB model bridge never writes it.
+        // Only roll back our exact config postimage; an external edit wins.
+        if restore_live_file(&config_path, &before_config, &intended_config).is_err() {
+            return Err(BridgeFailure::new("rollback-incomplete"));
+        }
+        return Err(BridgeFailure::from_snapshot(
+            &current_snapshot,
+            "apply-rolled-back",
+        ));
+    }
+    let config_hash =
+        written_hash.ok_or_else(|| BridgeFailure::new("postcondition-unconfirmed"))?;
+    // No fallible DB reads after commit. Reconstruct the same snapshot digest
+    // from transaction-confirmed values; the caller still rechecks file hashes.
+    let mut revision = current_snapshot.revision_basis.clone();
+    let mut saved_provider = current_snapshot.provider.clone();
+    saved_provider.settings_config = updated_provider.settings_config;
+    revision["provider"] = canonicalize_json(
+        &serde_json::to_value(saved_provider)
+            .map_err(|_| BridgeFailure::new("postcondition-unconfirmed"))?,
+    );
+    revision["databaseCurrentProvider"] =
+        json!(crate::services::provider::USB_404TOKEN_PROVIDER_ID);
+    revision["liveConfigSha256"] = json!(config_hash);
+    revision["liveAuthSha256"] = json!(current_snapshot.live.auth_sha256);
+    let revision_bytes = serde_json::to_vec(&canonicalize_json(&revision))
+        .map_err(|_| BridgeFailure::new("postcondition-unconfirmed"))?;
+    Ok(BridgeSuccess {
+        revision: sha256_hex(&revision_bytes),
+        selected_model: Some(requested_model),
+        config_sha256: Some(config_hash),
+        applied: true,
+    })
+}
+
+#[cfg(target_os = "windows")]
+fn load_usb_snapshot(state: &AppState) -> Result<UsbModelSelectionSnapshot, BridgeFailure> {
+    let provider = state
+        .db
+        .get_provider_by_id(
+            crate::services::provider::USB_404TOKEN_PROVIDER_ID,
+            AppType::Codex.as_str(),
+        )
+        .map_err(|_| BridgeFailure::new("provider-read-failed"))?
+        .ok_or_else(|| BridgeFailure::new("provider-missing"))?;
+
+    let provider_inspection = inspect_provider(&provider)?;
+    let live = read_live_config_snapshot()?;
+    let live_inspection = match live.config_text.as_deref() {
+        Some(config) if !config.trim().is_empty() => Some(inspect_live_usb_config(config)?),
+        _ => None,
+    };
+
+    let live_model = live_inspection
+        .as_ref()
+        .and_then(|inspection| inspection.model.clone());
+    if provider_inspection.model.is_some()
+        && live_model.is_some()
+        && provider_inspection.model != live_model
+    {
+        return Err(BridgeFailure::new("state-conflict"));
+    }
+    let selected_model = live_model
+        .clone()
+        .or_else(|| provider_inspection.model.clone());
+    let key = provider
+        .settings_config
+        .get("auth")
+        .and_then(|v| v.get("OPENAI_API_KEY"))
+        .and_then(Value::as_str)
+        .unwrap_or_default();
+    if selected_model
+        .as_deref()
+        .is_some_and(|m| !key.is_empty() && m.contains(key))
+    {
+        return Err(BridgeFailure::new("provider-config-invalid"));
+    }
+    let db_current = state
+        .db
+        .usb_model_selection_database_pointer()
+        .map_err(|_| BridgeFailure::new("provider-read-failed"))?;
+    let settings_current = crate::mode::current::local_direct_pointer(&AppType::Codex);
+    let provider_value =
+        serde_json::to_value(&provider).map_err(|_| BridgeFailure::new("revision-failed"))?;
+    let revision_payload = json!({
+        "schemaVersion": 3,
+        "bindingFingerprint": environment_binding_fingerprint()?,
+        "provider": canonicalize_json(&provider_value),
+        "databaseCurrentProvider": db_current,
+        "settingsCurrentProvider": settings_current,
+        "writerGeneration": "ccswitch-4-leaf-model-v1",
+        "codexConfigPath": get_codex_config_path().to_string_lossy(),
+        "codexAuthPath": get_codex_auth_path().to_string_lossy(),
+        "liveConfigSha256": live.config_sha256.clone(),
+        "liveAuthSha256": live.auth_sha256.clone(),
+    });
+    let revision_bytes = serde_json::to_vec(&canonicalize_json(&revision_payload))
+        .map_err(|_| BridgeFailure::new("revision-failed"))?;
+
+    Ok(UsbModelSelectionSnapshot {
+        provider,
+        provider_model: provider_inspection.model,
+        live_model,
+        selected_model,
+        live,
+        revision: sha256_hex(&revision_bytes),
+        revision_basis: revision_payload,
+    })
+}

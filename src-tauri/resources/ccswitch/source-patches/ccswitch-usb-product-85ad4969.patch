+            || provider.in_failover_queue
+            || provider
+                .meta
+                .as_ref()
+                .is_some_and(|meta| !meta.custom_endpoints.is_empty())
+        {
+            return Err(AppError::Config(
+                "USB bootstrap requires initial DB-only provider input".into(),
+            ));
+        }
+        let key = provider
+            .settings_config
+            .get("auth")
+            .and_then(|auth| auth.get("OPENAI_API_KEY"))
+            .and_then(serde_json::Value::as_str)
+            .filter(|key| !key.trim().is_empty())
+            .ok_or_else(failure)?;
+        let configured_base = |value: &serde_json::Value| -> Option<String> {
+            let document: toml::Value = value.get("config")?.as_str()?.parse().ok()?;
+            let provider = document.get("model_provider")?.as_str()?;
+            document
+                .get("model_providers")?
+                .get(provider)?
+                .get("base_url")?
+                .as_str()
+                .map(|url| url.trim_end_matches('/').to_owned())
+        };
+        let expected_base = configured_base(&provider.settings_config).ok_or_else(failure)?;
+        if expected_base != crate::services::provider::USB_404TOKEN_BASE_URL {
+            return Err(AppError::Config(
+                "USB bootstrap endpoint is not the bound endpoint".into(),
+            ));
+        }
+        let mut conn = lock_conn!(self.conn);
+        let tx = conn.transaction().map_err(|_| failure())?;
+        let existing: Option<String> = tx
+            .query_row(
+                "SELECT settings_config FROM providers WHERE id = ?1 AND app_type = 'codex'",
+                params![provider.id],
+                |row| row.get(0),
+            )
+            .optional()
+            .map_err(|_| failure())?;
+        if let Some(existing) = existing {
+            let mut settings: serde_json::Value =
+                serde_json::from_str(&existing).map_err(|_| failure())?;
+            // Never inject the signed USB credential into a customized remote endpoint.
+            // Keep that record intact and require explicit conflict resolution instead.
+            if configured_base(&settings).as_deref() != Some(expected_base.as_str()) {

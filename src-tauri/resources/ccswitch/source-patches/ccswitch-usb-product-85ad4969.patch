+#[test]
+fn usb_upgrade_full_import_preserves_all_tables_and_archives_runtime() {
+    let temp = tempfile::tempdir().unwrap();
+    let source = temp.path().join("legacy");
+    let target = temp.path().join("private");
+    let old = legacy(&source);
+    let before = std::fs::read(source.join(DB)).unwrap();
+    assert!(import_from(&source, &target).unwrap());
+    let raw = readonly_database(&target.join(ARCHIVE).join(DB)).unwrap();
+    let active = readonly_database(&target.join(DB)).unwrap();
+    let tables: Vec<String> = old
+        .prepare("SELECT name FROM sqlite_master WHERE type='table' ORDER BY name")
+        .unwrap()
+        .query_map([], |r| r.get(0))
+        .unwrap()
+        .collect::<Result<_, _>>()
+        .unwrap();
+    for table in tables {
+        assert_eq!(
+            table_rows(&old, &table),
+            table_rows(&raw, &table),
+            "archived {table}"
+        );
+        if !["proxy_config", "proxy_live_backup", "settings"].contains(&table.as_str()) {
+            assert_eq!(
+                table_rows(&old, &table),
+                table_rows(&active, &table),
+                "active {table}"
+            );
+        }
+    }
+    assert_eq!(std::fs::read(source.join(DB)).unwrap(), before);
+    assert_eq!(
+        active
+            .query_row(
+                "SELECT enabled FROM proxy_config WHERE app_type='codex'",
+                [],
+                |r| r.get::<_, i64>(0)
+            )
+            .unwrap(),
+        0
+    );
+    assert_eq!(
+        active
+            .query_row("SELECT count(*) FROM proxy_live_backup", [], |r| r
+                .get::<_, i64>(0))
+            .unwrap(),
+        0
+    );
+    assert!(!target.join("live-state.json").exists());
+    assert!(!target.join("codex-login-stash.json").exists());
+    assert_eq!(
+        std::fs::read(target.join(ARCHIVE).join("files/live-state.json")).unwrap(),
+        b"pending old intent"
+    );
+    assert_eq!(
+        std::fs::read(target.join("skills/user-skill/SKILL.md")).unwrap(),
+        b"synthetic skill"
+    );
+    let safe: serde_json::Value = serde_json::from_slice(
+        &std::fs::read(target.join(ARCHIVE).join("settings.safe.json")).unwrap(),
+    )
+    .unwrap();
+    assert_eq!(safe["language"], "zh");
+    assert_eq!(safe["currentProviderCodex"], "404token-sub2api");
+    for key in [
+        "codexConfigDir",
+        "launchOnStartup",
+        "webdavSync",
+        "unknownPreference",
+    ] {
+        assert!(safe.get(key).is_none());
+    }
+    let bytes = std::fs::read(target.join(DB)).unwrap();
+    assert!(!import_from(&source, &target).unwrap());
+    assert_eq!(std::fs::read(target.join(DB)).unwrap(), bytes);
+}

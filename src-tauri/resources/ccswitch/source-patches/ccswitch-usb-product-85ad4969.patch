diff --git a/tests/utils/codexTemplates.compatibility.test.ts b/tests/utils/codexTemplates.compatibility.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..15019fb72c2a0860fe76cc6b36989d7f82abc1c6
--- /dev/null
+++ b/tests/utils/codexTemplates.compatibility.test.ts
@@ -0,0 +1,64 @@
+import { describe, expect, it } from "vitest";
+import { getCodexCustomTemplate } from "../../src/config/codexTemplates";
+import {
+  codexProviderPresets,
+  generateThirdPartyConfig,
+} from "../../src/config/codexProviderPresets";
+import {
+  universalProviderPresets,
+  createUniversalProviderFromPreset,
+} from "../../src/config/universalProviderPresets";
+
+describe("custom Codex discovery template", () => {
+  it("does not fabricate a default model or reasoning effort", () => {
+    const { config, auth } = getCodexCustomTemplate();
+    expect(config).not.toMatch(/^model\s*=/m);
+    expect(config).not.toMatch(/^model_reasoning_effort\s*=/m);
+    expect(config).toContain('wire_api = "responses"');
+    expect(auth.OPENAI_API_KEY).toBe("");
+  });
+});
+
+describe("Codex provider presets do not select unverified defaults", () => {
+  it("keeps model, reasoning and context decisions out of every preset", () => {
+    for (const preset of codexProviderPresets) {
+      expect(preset.config).not.toMatch(/^model\s*=/m);
+      expect(preset.config).not.toMatch(/^model_reasoning_effort\s*=/m);
+      expect(preset.config).not.toMatch(/^model_context_window\s*=/m);
+      expect(preset.config).not.toMatch(/^model_auto_compact_token_limit\s*=/m);
+    }
+  });
+  it("omits absent/blank choices and renders only an explicit caller choice", () => {
+    expect(
+      generateThirdPartyConfig("fixture", "https://fixture.invalid/v1"),
+    ).not.toMatch(/^model\s*=/m);
+    expect(
+      generateThirdPartyConfig("fixture", "https://fixture.invalid/v1", "  "),
+    ).not.toMatch(/^model\s*=/m);
+    const explicit = generateThirdPartyConfig(
+      "fixture",
+      "https://fixture.invalid/v1",
+      "vendor/model-selected",
+    );
+    expect(explicit).toContain('model = "vendor/model-selected"');
+    expect(explicit).not.toMatch(/^model_reasoning_effort\s*=/m);
+  });
+});
+
+describe("universal-provider Codex defaults", () => {
+  it("does not preselect a Codex model or enable its synchronization", () => {
+    for (const preset of universalProviderPresets) {
+      const provider = createUniversalProviderFromPreset(
+        preset,
+        "fixture",
+        "https://fixture.invalid",
+        "fixture-key",
+      );
+      expect(provider.apps.codex).toBe(false);
+      expect(provider.models.codex?.model).toBeUndefined();
+      expect(provider.models.codex?.reasoningEffort).toBeUndefined();
+      expect(provider.apps.claude).toBe(preset.defaultApps.claude);
+      expect(provider.apps.gemini).toBe(preset.defaultApps.gemini);
+    }
+  });
+});
diff --git a/tests/utils/modelAliases.test.ts b/tests/utils/modelAliases.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..8094a2b257625d1e34ef505e3102bfbcc4124f98
--- /dev/null
+++ b/tests/utils/modelAliases.test.ts
@@ -0,0 +1,96 @@
+import { describe, expect, it } from "vitest";
+import { canonicalModelId, collapseReleaseAliases } from "@/lib/model-aliases";
+import type { FetchedModel } from "@/lib/api/model-fetch";
+
+function model(id: string, ownedBy?: string): FetchedModel {
+  return { id, ownedBy: ownedBy ?? null };
+}
+
+describe("model release alias collapsing", () => {
+  it("canonicalizes only supported release suffixes", () => {
+    expect(canonicalModelId("gpt-6-latest")).toBe("gpt-6");
+    expect(canonicalModelId("deepseek-v4-2026-09-20")).toBe("deepseek-v4");
+    expect(canonicalModelId("glm-5-20260920")).toBe("glm-5");
+    expect(canonicalModelId("vendor-model-2028-02-29")).toBe("vendor-model");
+    expect(canonicalModelId("vendor-model-2025-02-29")).toBe(
+      "vendor-model-2025-02-29",
+    );
+    expect(canonicalModelId("qwen-embedding")).toBe("qwen-embedding");
+  });
+
+  it("keeps all vendors while choosing one representative per release family", () => {
+    const result = collapseReleaseAliases([
+      model("gpt-6-2026-09-20", "openai"),
+      model("gpt-6-latest", "openai"),
+      model("gpt-6", "openai"),
+      model("deepseek-v4-20260920", "deepseek"),
+      model("deepseek-v4-stable", "deepseek"),
+      model("glm-5-20260920", "zhipu"),
+    ]);
+
+    expect(result).toEqual([
+      {
+        id: "deepseek-v4-stable",
+        displayName: "deepseek-v4",
+        ownedBy: "deepseek",
+      },
+      { id: "gpt-6", displayName: "gpt-6", ownedBy: "openai" },
+      { id: "glm-5-20260920", displayName: "glm-5", ownedBy: "zhipu" },
+    ]);
+  });
+
+  it("prefers stable over latest and latest over dated aliases when the base is absent", () => {
+    const result = collapseReleaseAliases([
+      model("model-2026-09-19", "vendor"),
+      model("model-latest", "vendor"),
+      model("model-stable", "vendor"),
+    ]);
+
+    expect(result).toEqual([
+      { id: "model-stable", displayName: "model", ownedBy: "vendor" },
+    ]);
+  });
+
+  it("chooses the newest valid date if no base or semantic alias exists", () => {
+    const result = collapseReleaseAliases([
+      model("model-2026-01-01", "vendor"),
+      model("model-2026-09-20", "vendor"),
+      model("model-20260919", "vendor"),
+    ]);
+
+    expect(result).toEqual([
+      { id: "model-2026-09-20", displayName: "model", ownedBy: "vendor" },
+    ]);
+  });
+
+  it("does not merge semantically different names or different vendor namespaces", () => {
+    const result = collapseReleaseAliases([
+      model("model-mini", "vendor"),
+      model("model-pro", "vendor"),
+      model("model", "other-vendor"),
+      model("model-latest", "vendor"),
+    ]);
+
+    expect(result).toEqual([
+      { id: "model", displayName: "model", ownedBy: "other-vendor" },
+      { id: "model-latest", displayName: "model", ownedBy: "vendor" },
+      { id: "model-mini", displayName: "model-mini", ownedBy: "vendor" },
+      { id: "model-pro", displayName: "model-pro", ownedBy: "vendor" },
+    ]);
+  });
+
+  it("is deterministic and ignores blank IDs", () => {
+    const first = collapseReleaseAliases([
+      model(" "),
+      model("foo-latest", "vendor"),
+      model("foo", "vendor"),
+    ]);
+    const second = collapseReleaseAliases([
+      model("foo", "vendor"),
+      model("foo-latest", "vendor"),
+      model("\t"),
+    ]);
+
+    expect(first).toEqual(second);
+  });
+});

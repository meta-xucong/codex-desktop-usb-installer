diff --git a/src-tauri/src/services/provider/usb_bootstrap.rs b/src-tauri/src/services/provider/usb_bootstrap.rs
new file mode 100644
index 0000000000000000000000000000000000000000..0c7b6e5bfc8b95d41a0c7148b62982e04607acc1
--- /dev/null
+++ b/src-tauri/src/services/provider/usb_bootstrap.rs
@@ -0,0 +1,629 @@
+//! USB credential handoff adapted to the official 4.x field-write transaction.
+//! Never restore a 3.x whole-file snapshot over the 4.x recovery journal.
+use super::ProviderService;
+use crate::{app_config::AppType, error::AppError, provider::Provider, store::AppState};
+use serde_json::Value;
+use std::path::PathBuf;
+
+pub(crate) const USB_404TOKEN_PROVIDER_ID: &str = "404token-sub2api";
+pub(crate) const USB_404TOKEN_BASE_URL: &str = "https://404token.xyz/v1";
+const DEVICE_KEY_ENV: &str = "CCSWITCH_404TOKEN_DEVICE_KEY";
+const HANDOFF_PROTOCOL: &str = "CODEX_USB_404TOKEN_HANDOFF_V1";
+
+thread_local! { static USB_BOOTSTRAP: std::cell::Cell<bool> = const { std::cell::Cell::new(false) }; }
+struct BootstrapContext(bool);
+impl Drop for BootstrapContext {
+    fn drop(&mut self) {
+        USB_BOOTSTRAP.with(|v| v.set(self.0));
+    }
+}
+fn in_bootstrap<T>(run: impl FnOnce() -> T) -> T {
+    let _restore = BootstrapContext(USB_BOOTSTRAP.with(|v| v.replace(true)));
+    run()
+}
+
+fn bound_route_has_no_auth_overrides(doc: &toml::Value, key: &str) -> bool {
+    if ["openai_base_url", "env_key", "experimental_bearer_token"]
+        .iter()
+        .any(|k| doc.get(*k).is_some())
+    {
+        return false;
+    }
+    let Some(id) = doc.get("model_provider").and_then(toml::Value::as_str) else {
+        return false;
+    };
+    let Some(route) = doc.get("model_providers").and_then(|v| v.get(id)) else {
+        return false;
+    };
+    ![
+        "env_key",
+        "http_headers",
+        "env_http_headers",
+        "auth",
+        "aws",
+        "query_params",
+    ]
+    .iter()
+    .any(|k| route.get(*k).is_some())
+        && route
+            .get("experimental_bearer_token")
+            .is_none_or(|v| v.as_str() == Some(key))
+        && route.get("wire_api").and_then(toml::Value::as_str) == Some("responses")
+}
+
+fn validate_existing_bound_route_auth() -> Result<(), AppError> {
+    let path = crate::codex_config::get_codex_config_path();
+    let text = match std::fs::read_to_string(&path) {
+        Ok(text) => text,
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => return Ok(()),
+        Err(error) => return Err(AppError::io(path, error)),
+    };
+    let doc: toml::Value = toml::from_str(&text)
+        .map_err(|_| AppError::Config("USB live configuration invalid".into()))?;
+    let route = doc
+        .get("model_provider")
+        .and_then(toml::Value::as_str)
+        .and_then(|id| doc.get("model_providers").and_then(|v| v.get(id)));
+    if let Some(route) = route.filter(|r| {
+        r.get("base_url")
+            .and_then(toml::Value::as_str)
+            .is_some_and(|url| url.trim_end_matches('/') == USB_404TOKEN_BASE_URL)
+    }) {
+        // Credential rotation may replace the old inline bearer, but must not
+        // silently erase a user-selected alternative credential source.
+        let old_key = route
+            .get("experimental_bearer_token")
+            .and_then(toml::Value::as_str)
+            .unwrap_or("");
+        if !bound_route_has_no_auth_overrides(&doc, old_key) {
+            return Err(AppError::Config(
+                "USB live authentication conflicts with the bound device credential".into(),
+            ));
+        }
+    }
+    Ok(())
+}
+
+pub(crate) fn validate_protected_provider(provider: &Provider) -> Result<(), AppError> {
+    if provider.id != USB_404TOKEN_PROVIDER_ID {
+        return Ok(());
+    }
+    let key = std::env::var(DEVICE_KEY_ENV).unwrap_or_default();
+    let config = provider
+        .settings_config
+        .get("config")
+        .and_then(Value::as_str)
+        .unwrap_or("");
+    let endpoint = crate::codex_config::extract_codex_base_url(config);
+    let safe_auth = toml::from_str::<toml::Value>(config)
+        .ok()
+        .is_some_and(|doc| bound_route_has_no_auth_overrides(&doc, key.trim()));
+    if USB_BOOTSTRAP.with(std::cell::Cell::get)
+        && crate::config::usb_app_config_dir().is_some()
+        && !key.trim().is_empty()
+        && safe_auth
+        && provider
+            .settings_config
+            .pointer("/auth/OPENAI_API_KEY")
+            .and_then(Value::as_str)
+            == Some(key.trim())
+        && endpoint
+            .as_deref()
+            .is_some_and(|url| url.trim_end_matches('/') == USB_404TOKEN_BASE_URL)
+    {
+        return Ok(());
+    }
+    Err(AppError::Config(
+        "USB provider model changes require the manager's verified model-selection flow".into(),
+    ))
+}
+
+struct Handoff {
+    path: PathBuf,
+    nonce: String,
+}
+impl Handoff {
+    fn from_environment() -> Result<Option<Self>, AppError> {
+        let path = std::env::var("CCSWITCH_404TOKEN_HANDOFF_PATH").ok();
+        let nonce = std::env::var("CCSWITCH_404TOKEN_HANDOFF_NONCE").ok();
+        let (raw_path, nonce) = match (path, nonce) {
+            (None, None) => return Ok(None),
+            (Some(path), Some(nonce)) => (path, nonce),
+            _ => return Err(AppError::Config("Incomplete USB handoff descriptor".into())),
+        };
+        let parsed = uuid::Uuid::parse_str(&nonce)
+            .map_err(|_| AppError::Config("Invalid USB handoff nonce".into()))?;
+        if parsed.to_string() != nonce {
+            return Err(AppError::Config("Noncanonical USB handoff nonce".into()));
+        }
+        let path = PathBuf::from(raw_path);
+        let expected_name = format!("codex-usb-ccswitch-handoff-{nonce}.json");
+        if path.file_name().and_then(std::ffi::OsStr::to_str) != Some(expected_name.as_str())
+            || path.exists()
+        {
+            return Err(AppError::Config(
+                "USB handoff path is invalid or already exists".into(),
+            ));
+        }
+        let expected_parent = std::fs::canonicalize(std::env::temp_dir())
+            .map_err(|_| AppError::Config("USB temporary directory unavailable".into()))?;
+        let actual_parent = path.parent().and_then(|p| std::fs::canonicalize(p).ok());
+        if actual_parent.as_ref() != Some(&expected_parent) {
+            return Err(AppError::Config(
+                "USB handoff must use the temporary directory".into(),
+            ));
+        }
+        Ok(Some(Self { path, nonce }))
+    }
+    fn acknowledge(&self, key: &str) -> Result<(), AppError> {
+        use sha2::{Digest, Sha256};
+        use std::io::Write;
+        let fingerprint = Sha256::digest(key.as_bytes())
+            .iter()
+            .map(|v| format!("{v:02x}"))
+            .collect::<String>();
+        let bytes = serde_json::to_vec(&serde_json::json!({
+            "protocol": HANDOFF_PROTOCOL, "nonce": self.nonce, "status": "verified",
+            "providerId": USB_404TOKEN_PROVIDER_ID, "credentialSha256": fingerprint,
+        }))
+        .map_err(|_| AppError::Config("USB handoff serialization failed".into()))?;
+        let mut file = std::fs::OpenOptions::new()
+            .write(true)
+            .create_new(true)
+            .open(&self.path)
+            .map_err(|e| AppError::io(&self.path, e))?;
+        file.write_all(&bytes)
+            .and_then(|()| file.sync_all())
+            .map_err(|e| AppError::io(&self.path, e))
+    }
+}

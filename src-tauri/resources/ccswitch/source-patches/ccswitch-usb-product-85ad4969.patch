diff --git a/src-tauri/src/database/usb_legacy_import.rs b/src-tauri/src/database/usb_legacy_import.rs
new file mode 100644
index 0000000000000000000000000000000000000000..5159530fdec15bd33af55e518c7d57d33a18e51c
--- /dev/null
+++ b/src-tauri/src/database/usb_legacy_import.rs
@@ -0,0 +1,559 @@
+//! First-run USB import: consistent SQLite copy, never an in-place shared upgrade.
+//! Raw legacy state remains an archive; only the isolated copy is made runnable.
+use super::Database;
+use crate::error::AppError;
+use rusqlite::{backup::Backup, Connection, OpenFlags};
+use std::path::Path;
+
+const ARCHIVE: &str = "legacy-v3-import";
+const DB: &str = "cc-switch.db";
+const FORMAT: &str = "CODEX_USB_FULL_IMPORT_V1\n";
+
+pub(super) fn import_if_needed() -> Result<bool, AppError> {
+    let Some(target) = crate::config::usb_app_config_dir() else {
+        return Ok(false);
+    };
+    let home = crate::config::get_home_dir();
+    let default = home.join(".cc-switch");
+    if target.join(DB).exists() {
+        return import_from_with_device(&default, &target, &default);
+    }
+    // Verified against tauri-plugin-store 2.4.2 resolve_store_path and Tauri
+    // 2.10.3 PathResolver::app_data_dir: data_dir / identifier / app_paths.json.
+    // Test-home isolation must never consult the machine's actual Tauri store.
+    let data_dir = if std::env::var_os("CC_SWITCH_TEST_HOME").is_some() {
+        home.join(".test-app-data")
+    } else {
+        dirs::data_dir().ok_or_else(|| {
+            AppError::Config("Cannot locate legacy Tauri app data directory".into())
+        })?
+    };
+    let store = data_dir.join("com.ccswitch.desktop/app_paths.json");
+    let legacy_home = if cfg!(windows) && std::env::var_os("CC_SWITCH_TEST_HOME").is_none() {
+        std::env::var_os("HOME")
+    } else {
+        None
+    };
+    let database_default = legacy_default_source(&default, legacy_home.as_deref())?;
+    let source = resolve_source(
+        std::env::var_os("CCSWITCH_USB_LEGACY_HOME").as_deref(),
+        &home,
+        &database_default,
+        &store,
+    )?;
+    import_from_with_device(&source, &target, &default)
+}
+
+// Exact legacy Windows v3.14.1 fallback, disabled by the caller in tests/non-Windows.
+fn legacy_default_source(
+    default: &Path,
+    legacy_home: Option<&std::ffi::OsStr>,
+) -> Result<std::path::PathBuf, AppError> {
+    if !default.join(DB).exists() {
+        if let Some(home) = legacy_home.filter(|home| !home.is_empty()) {
+            let candidate = std::path::PathBuf::from(home).join(".cc-switch");
+            if candidate.join(DB).exists() {
+                validate_source_path(&candidate)?;
+                return Ok(candidate);
+            }
+        }
+    }
+    Ok(default.to_path_buf())
+}
+
+fn validate_source_path(path: &Path) -> Result<(), AppError> {
+    if !path.is_absolute()
+        || path.file_name().is_none()
+        || path
+            .components()
+            .any(|p| matches!(p, std::path::Component::ParentDir))
+    {
+        return Err(AppError::Config(
+            "Legacy CC Switch source must be an absolute dedicated directory".into(),
+        ));
+    }
+
+    if !path.join(DB).is_file() {
+        return Err(AppError::Config(
+            "Selected legacy CC Switch source has no cc-switch.db; verify CCSWITCH_USB_LEGACY_HOME"
+                .into(),
+        ));
+    }
+    Ok(())
+}
+
+fn resolve_source(
+    explicit: Option<&std::ffi::OsStr>,
+    home: &Path,
+    default: &Path,
+    store: &Path,
+) -> Result<std::path::PathBuf, AppError> {
+    if let Some(explicit) = explicit {
+        let path = std::path::PathBuf::from(explicit);
+        validate_source_path(&path)?;
+        return Ok(path);
+    }
+
+    let bytes = match std::fs::read(store) {
+        Ok(bytes) => bytes,
+        Err(e) if e.kind() == std::io::ErrorKind::NotFound => return Ok(default.to_path_buf()),
+        Err(e) => return Err(AppError::io(store, e)),
+    };
+    let value: serde_json::Value = serde_json::from_slice(&bytes).map_err(|_| {
+        AppError::Config(
+            "Legacy app_paths.json is malformed; supply verified CCSWITCH_USB_LEGACY_HOME".into(),
+        )
+    })?;
+    let object = value
+        .as_object()
+        .ok_or_else(|| AppError::Config("Legacy app_paths.json must contain an object".into()))?;
+    let Some(raw) = object.get("app_config_dir_override") else {
+        return Ok(default.to_path_buf());
+    };
+    let raw = raw
+        .as_str()
+        .ok_or_else(|| AppError::Config("Legacy app_config_dir_override is not a string".into()))?
+        .trim();
+    if raw.is_empty() {
+        return Ok(default.to_path_buf());
+    }
+    // Match the legacy resolver's supported home expansion, not arbitrary env interpolation.
+    let path = if raw == "~" {
+        home.to_path_buf()
+    } else if let Some(rest) = raw.strip_prefix("~/").or_else(|| raw.strip_prefix("~\\")) {
+        home.join(rest)
+    } else {
+        std::path::PathBuf::from(raw)
+    };
+    validate_source_path(&path)?;
+    Ok(path)
+}
+
+fn private_dir(path: &Path) -> Result<(), AppError> {
+    std::fs::create_dir_all(path).map_err(|e| AppError::io(path, e))?;
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::PermissionsExt;
+        std::fs::set_permissions(path, std::fs::Permissions::from_mode(0o700))
+            .map_err(|e| AppError::io(path, e))?;
+    }
+    Ok(())
+}
+
+fn reject_link(path: &Path, metadata: &std::fs::Metadata) -> Result<(), AppError> {
+    #[allow(unused_mut)]
+    let mut linked = metadata.file_type().is_symlink();
+    #[cfg(windows)]
+    {
+        use std::os::windows::fs::MetadataExt;
+        linked |= metadata.file_attributes() & 0x400 != 0; // FILE_ATTRIBUTE_REPARSE_POINT
+    }
+    if linked || (!metadata.is_file() && !metadata.is_dir()) {
+        return Err(AppError::Config(format!(
+            "USB import refuses linked/special path: {}",
+            path.display()
+        )));
+    }
+    Ok(())
+}
+
+fn readonly_database(path: &Path) -> Result<Connection, AppError> {
+    Connection::open_with_flags(path, OpenFlags::SQLITE_OPEN_READ_ONLY)
+        .map_err(|e| AppError::Database(format!("USB legacy database cannot be read: {e}")))
+}
+
+fn validate_legacy_schema(conn: &Connection) -> Result<(), AppError> {
+    let version = Database::get_user_version(conn)?;
+    if version <= 0 || version > super::SCHEMA_VERSION {
+        return Err(AppError::Database(format!(
+            "Unsupported legacy USB database schema {version}"
+        )));
+    }
+    for table in ["providers", "settings", "mcp_servers", "prompts"] {
+        if !Database::table_exists(conn, table)? {
+            return Err(AppError::Database(
+                "Legacy source is not a recognized CC Switch database".into(),
+            ));
+        }
+    }
+    for column in ["id", "app_type", "settings_config"] {
+        if !Database::has_column(conn, "providers", column)? {
+            return Err(AppError::Database(
+                "Legacy provider table has an unsupported shape".into(),
+            ));
+        }
+    }
+    Ok(())
+}
+
+fn hash_file(path: &Path) -> Result<Vec<u8>, AppError> {
+    use sha2::{Digest, Sha256};
+    use std::io::Read;
+    let mut file = std::fs::File::open(path).map_err(|e| AppError::io(path, e))?;
+    let mut hash = Sha256::new();
+    let mut buffer = [0u8; 64 * 1024];
+    loop {
+        let read = file.read(&mut buffer).map_err(|e| AppError::io(path, e))?;
+        if read == 0 {
+            break;
+        }
+        hash.update(&buffer[..read]);
+    }
+    Ok(hash.finalize().to_vec())
+}
+
+/// Flush only a newly-created destination, never the legacy source. Windows'
+/// FlushFileBuffers requires GENERIC_WRITE, so a read-only File::open handle is
+/// insufficient. A copied read-only attribute is normalized on the destination
+/// only; on Unix this also keeps archived credentials owner-private.
+fn flush_owned_destination(path: &Path) -> Result<(), AppError> {
+    let metadata = std::fs::symlink_metadata(path).map_err(|e| AppError::io(path, e))?;
+    reject_link(path, &metadata)?;
+    if !metadata.is_file() {
+        return Err(AppError::Config(
+            "USB flush destination must be a regular file".into(),
+        ));
+    }
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::PermissionsExt;
+        std::fs::set_permissions(path, std::fs::Permissions::from_mode(0o600))
+            .map_err(|e| AppError::io(path, e))?;
+    }
+    #[cfg(windows)]
+    {
+        if metadata.permissions().readonly() {
+            let mut permissions = metadata.permissions();
+            permissions.set_readonly(false);
+            std::fs::set_permissions(path, permissions).map_err(|e| AppError::io(path, e))?;
+        }
+    }
+    // Deliberately neither create nor truncate: missing destinations are errors,
+    // and syncing must not alter any copied bytes.
+    std::fs::OpenOptions::new()
+        .write(true)
+        .open(path)
+        .and_then(|file| file.sync_all())
+        .map_err(|e| AppError::io(path, e))
+}
+
+fn backup_to(source: &Connection, path: &Path) -> Result<(), AppError> {
+    let mut dest = Connection::open(path).map_err(|e| AppError::Database(e.to_string()))?;
+    let backup = Backup::new(source, &mut dest).map_err(|e| AppError::Database(e.to_string()))?;
+    Database::complete_backup(&backup, "USB legacy database snapshot")?;
+    drop(backup);
+    Database::validate_sqlite_integrity(&dest)?;
+    dest.close()
+        .map_err(|(_, e)| AppError::Database(e.to_string()))?;
+    flush_owned_destination(path)
+}
+
+// No link following: a shared path may point outside the legacy application home.
+fn copy_tree(source: &Path, target: &Path, root: bool) -> Result<(), AppError> {
+    private_dir(target)?;
+    for entry in std::fs::read_dir(source).map_err(|e| AppError::io(source, e))? {
+        let entry = entry.map_err(|e| AppError::io(source, e))?;
+        let name = entry.file_name();
+        if root
+            && [
+                DB,
+                "cc-switch.db-wal",
+                "cc-switch.db-shm",
+                "cc-switch.db-journal",
+            ]
+            .iter()
+            .any(|n| name == *n)
+        {
+            continue;
+        }
+        let from = entry.path();
+        let to = target.join(name);
+        let metadata = std::fs::symlink_metadata(&from).map_err(|e| AppError::io(&from, e))?;
+        reject_link(&from, &metadata)?;
+        if metadata.is_dir() {
+            copy_tree(&from, &to, false)?;
+        } else {
+            std::fs::copy(&from, &to).map_err(|e| AppError::io(&from, e))?;
+            let after = std::fs::symlink_metadata(&from).map_err(|e| AppError::io(&from, e))?;
+            reject_link(&from, &after)?;
+            if metadata.len() != after.len()
+                || metadata.modified().ok() != after.modified().ok()
+                || hash_file(&from)? != hash_file(&to)?
+            {
+                return Err(AppError::Config(format!(
+                    "Legacy file changed while copying; retry after closing old CC Switch: {}",
+                    from.display()
+                )));
+            }
+            flush_owned_destination(&to)?;
+        }
+    }
+    Ok(())
+}
+
+fn safe_settings(raw: &[u8]) -> Result<Vec<u8>, AppError> {
+    let value: serde_json::Value = serde_json::from_slice(raw)
+        .map_err(|e| AppError::Config(format!("Legacy settings JSON is invalid: {e}")))?;
+    let object = value
+        .as_object()
+        .ok_or_else(|| AppError::Config("Legacy settings must be an object".into()))?;
+    // Unknown settings remain in the raw archive, not silently activated. In
+    // particular no cloud sync, autostart, application path or pending migration.
+    let mut safe = serde_json::Map::new();
+    for key in [
+        "showInTray",
+        "minimizeToTrayOnClose",
+        "useAppWindowControls",
+        "language",
+        "quotaDisplay",
+        "usageDisplay",
+        "backupIntervalHours",
+        "backupRetainCount",
+        "preferredTerminal",
+        "firstRunNoticeConfirmed",
+        "newLayoutNoticeConfirmed",
+        "whatsNewSeenVersion",
+        "commonConfigConfirmed",
+        "failoverConfirmed",
+        "currentProviderClaude",
+        "currentProviderClaudeDesktop",
+        "currentProviderCodex",
+        "currentProviderGemini",
+        "currentProviderGrokbuild",
+        "currentProviderOpencode",
+        "currentProviderOpenclaw",
+        "currentProviderHermes",
+        "currentProviderAgy",
+    ] {
+        if let Some(value) = object.get(key) {
+            safe.insert(key.into(), value.clone());
+        }
+    }
+    serde_json::to_vec_pretty(&safe).map_err(|e| AppError::Config(e.to_string()))
+}
+
+fn pause_runtime(conn: &Connection) -> Result<(), AppError> {
+    // Full originals (including these runtime snapshots) remain in the archive.
+    // Imported stale takeover state must not restore files belonging to stock apps.
+    for column in [
+        "proxy_enabled",
+        "enabled",
+        "auto_failover_enabled",
+        "live_takeover_active",
+    ] {
+        if Database::table_exists(conn, "proxy_config")?
+            && Database::has_column(conn, "proxy_config", column)?
+        {
+            conn.execute(&format!("UPDATE proxy_config SET {column} = 0"), [])
+                .map_err(|e| AppError::Database(e.to_string()))?;
+        }
+    }
+    if Database::table_exists(conn, "proxy_live_backup")? {
+        conn.execute("DELETE FROM proxy_live_backup", [])
+            .map_err(|e| AppError::Database(e.to_string()))?;
+    }
+    if Database::table_exists(conn, "settings")? {
+        conn.execute(
+            "UPDATE settings SET value='false' WHERE key GLOB 'proxy_takeover_*'",
+            [],
+        )
+        .map_err(|e| AppError::Database(e.to_string()))?;
+    }
+    Ok(())
+}
+
+fn same_tree(left: &Path, right: &Path) -> Result<bool, AppError> {
+    let left_meta = std::fs::symlink_metadata(left).map_err(|e| AppError::io(left, e))?;
+    let right_meta = std::fs::symlink_metadata(right).map_err(|e| AppError::io(right, e))?;
+    reject_link(left, &left_meta)?;
+    reject_link(right, &right_meta)?;
+    if left_meta.is_file() && right_meta.is_file() {
+        return Ok(left_meta.len() == right_meta.len() && hash_file(left)? == hash_file(right)?);
+    }
+    if !left_meta.is_dir() || !right_meta.is_dir() {
+        return Ok(false);
+    }
+    let names = |path: &Path| -> Result<Vec<std::ffi::OsString>, AppError> {
+        let mut names = std::fs::read_dir(path)
+            .map_err(|e| AppError::io(path, e))?
+            .map(|entry| {
+                entry
+                    .map(|entry| entry.file_name())
+                    .map_err(|e| AppError::io(path, e))
+            })
+            .collect::<Result<Vec<_>, _>>()?;
+        names.sort();
+        Ok(names)
+    };
+    let children = names(left)?;
+    if children != names(right)? {
+        return Ok(false);
+    }
+    for name in children {
+        if !same_tree(&left.join(&name), &right.join(&name))? {
+            return Ok(false);
+        }
+    }
+    Ok(true)
+}
+
+fn asset_conflict(path: &Path) -> AppError {
+    AppError::Config(format!(
+        "Existing USB assets differ from imported archive; not overwritten: {}",
+        path.display()
+    ))
+}
+
+fn publish_asset(archive: &Path, target: &Path, name: &str) -> Result<(), AppError> {
+    let source = archive.join("files").join(name);
+    let dest = target.join(name);
+
+    if !source.is_dir() {
+        return Ok(());
+    }
+    if dest.exists() {
+        return if same_tree(&source, &dest)? {
+            Ok(())
+        } else {
+            Err(asset_conflict(&dest))
+        };
+    }
+    let stage = tempfile::Builder::new()
+        .prefix(".usb-assets-")
+        .tempdir_in(target)
+        .map_err(|e| AppError::io(target, e))?;
+    let candidate = stage.path().join(name);
+    copy_tree(&source, &candidate, false)?;
+    match std::fs::rename(&candidate, &dest) {
+        Ok(()) => Ok(()),
+        Err(_) if dest.exists() => {
+            if same_tree(&source, &dest)? {
+                Ok(())
+            } else {
+                Err(asset_conflict(&dest))
+            }
+        }
+        Err(e) => Err(AppError::io(&dest, e)),
+    }
+}
+
+#[cfg(test)]
+fn import_from(source: &Path, target: &Path) -> Result<bool, AppError> {
+    import_from_with_device(source, target, source)
+}
+
+fn import_from_with_device(
+    source: &Path,
+    target: &Path,
+    device_home: &Path,
+) -> Result<bool, AppError> {
+    // An existing private database is always authoritative, even if empty or
+    // invalid: never "repair" it by silently replacing it with an older source.
+
+    if target.join(DB).exists() {
+        return Ok(false);
+    }
+
+    let archive = target.join(ARCHIVE);
+    if !archive.exists() && !source.join(DB).exists() {
+        return Ok(false);
+    }
+    if source == target {
+        return Err(AppError::Config("USB legacy source equals target".into()));
+    }
+    std::fs::create_dir_all(target).map_err(|e| AppError::io(target, e))?;
+    if source.exists() {
+        let source_real = source.canonicalize().map_err(|e| AppError::io(source, e))?;
+        let target_real = target.canonicalize().map_err(|e| AppError::io(target, e))?;
+        if target_real.starts_with(&source_real) || source_real.starts_with(&target_real) {
+            return Err(AppError::Config(
+                "USB import source/target directories overlap".into(),
+            ));
+        }
+    }
+    if !archive.exists() {
+        if device_home != source && device_home.exists() {
+            let device_real = device_home
+                .canonicalize()
+                .map_err(|e| AppError::io(device_home, e))?;
+            let target_real = target.canonicalize().map_err(|e| AppError::io(target, e))?;
+            if target_real.starts_with(&device_real) || device_real.starts_with(&target_real) {
+                return Err(AppError::Config(
+                    "USB import device home/target directories overlap".into(),
+                ));
+            }
+        }
+        let stage = tempfile::Builder::new()
+            .prefix(".usb-import-")
+            .tempdir_in(target)
+            .map_err(|e| AppError::io(target, e))?;
+        let bundle = stage.path().join(ARCHIVE);
+        private_dir(&bundle)?;
+        let conn = readonly_database(&source.join(DB))?;
+        validate_legacy_schema(&conn)?;
+        backup_to(&conn, &bundle.join(DB))?;
+        copy_tree(source, &bundle.join("files"), true)?;
+        // Legacy device settings/journals ignore the database directory override.
+        // Preserve them separately; never activate the journal or login stash.
+        let settings = if device_home != source && device_home.exists() {
+            copy_tree(device_home, &bundle.join("device-files"), true)?;
+            bundle.join("device-files/settings.json")
+        } else {
+            bundle.join("files/settings.json")
+        };
+        if settings.exists() {
+            let raw = std::fs::read(&settings).map_err(|e| AppError::io(&settings, e))?;
+            match safe_settings(&raw) {
+                Ok(seed) => std::fs::write(bundle.join("settings.safe.json"), seed)
+                    .map_err(|e| AppError::io(&bundle, e))?,
+                Err(_) => log::warn!("Legacy settings are invalid; raw file archived, optional UI preferences skipped"),
+            }
+        }
+        std::fs::write(bundle.join("format"), FORMAT).map_err(|e| AppError::io(&bundle, e))?;
+        match std::fs::rename(&bundle, &archive) {
+            Ok(()) => (),
+            Err(_) if archive.is_dir() => (), // Another importer published first.
+            Err(e) => return Err(AppError::io(&archive, e)),
+        }
+    }
+    // A crash after publishing the complete archive is resumable. An unmarked
+    // partial/pre-existing directory is not trusted and cannot become live data.
+
+    let marker =
+        std::fs::read_to_string(archive.join("format")).map_err(|e| AppError::io(&archive, e))?;
+    if marker != FORMAT {
+        return Err(AppError::Config("Invalid USB legacy import archive".into()));
+    }
+    let archived = readonly_database(&archive.join(DB))?;
+    Database::validate_sqlite_integrity(&archived)?;
+    validate_legacy_schema(&archived)?;
+    let staged = tempfile::Builder::new()
+        .prefix(".usb-db-")
+        .tempfile_in(target)
+        .map_err(|e| AppError::io(target, e))?
+        .into_temp_path();
+    backup_to(&archived, &staged)?;
+    let writable = Connection::open(&staged).map_err(|e| AppError::Database(e.to_string()))?;
+    pause_runtime(&writable)?;
+    Database::validate_sqlite_integrity(&writable)?;
+    writable
+        .close()
+        .map_err(|(_, e)| AppError::Database(e.to_string()))?;
+    for name in ["skills", "skill-backups"] {
+        publish_asset(&archive, target, name)?;
+    }
+    flush_owned_destination(&staged)?;
+    match staged.persist_noclobber(target.join(DB)) {
+        Ok(()) => {
+            log::info!(
+                "CODEX_USB_FULL_IMPORT_V1: isolated legacy snapshot published; original untouched"
+            );
+            Ok(true)
+        }
+        Err(error) if error.error.kind() == std::io::ErrorKind::AlreadyExists => Ok(false),
+        Err(error) => Err(AppError::io(target, error.error)),
+    }
+}

+//! USB 3.14.1 (schema 10) -> official 4.0.20 (schema 23) migration contracts.
+//! Synthetic values only; invokes the production migration chain, not a SQL model.
+use super::{Database, SCHEMA_VERSION};
+use rusqlite::Connection;
+
+const OLD_SCHEMA: &str = include_str!("fixtures/usb-schema-v10.sql");
+const PROVIDER_JSON: &str = r#"{"auth":{"OPENAI_API_KEY":"synthetic-not-a-real-key"},"config":"model_provider = '404token'\n[plugins.'browser@openai-bundled']\nenabled = false\n"}"#;
+const COMMON_CONFIG: &str = "approval_policy = 'never'\nsandbox_mode = 'danger-full-access'\n";
+
+fn old_database() -> Connection {
+    let conn = Connection::open_in_memory().unwrap();
+    conn.execute_batch(OLD_SCHEMA).unwrap();
+    conn.execute("INSERT INTO providers (id,app_type,name,settings_config,is_current) VALUES ('404token-sub2api','codex','USB synthetic',?1,1)", [PROVIDER_JSON]).unwrap();
+    conn.execute(
+        "INSERT INTO settings (key,value) VALUES ('common_config_codex',?1)",
+        [COMMON_CONFIG],
+    )
+    .unwrap();
+    conn.execute_batch("INSERT INTO mcp_servers (id,name,server_config,enabled_codex) VALUES ('media','Media','{\"command\":\"synthetic-media\"}',1),('disabled','Disabled','{\"command\":\"synthetic-disabled\"}',0);
+        INSERT INTO prompts (id,app_type,name,content) VALUES ('user-prompt','codex','Synthetic','keep me');
+        INSERT INTO proxy_request_logs (request_id,provider_id,app_type,model,latency_ms,status_code,created_at,data_source) VALUES ('proxy-record','404token-sub2api','codex','synthetic',10,200,1,'proxy'),('derived-codex','_codex_session','codex','synthetic',10,200,1,'codex_session');
+        INSERT INTO usage_daily_rollups (date,app_type,provider_id,model,request_count,total_cost_usd) VALUES ('2026-10-25','codex','404token-sub2api','synthetic',3,'0.25');").unwrap();
+    conn
+}
+
+fn assert_user_rows_preserved(conn: &Connection) {
+    let provider: (String,i64) = conn.query_row("SELECT settings_config,is_current FROM providers WHERE id='404token-sub2api' AND app_type='codex'", [], |r| Ok((r.get(0)?,r.get(1)?))).unwrap();
+    assert_eq!(provider, (PROVIDER_JSON.to_owned(), 1));
+    let common: String = conn
+        .query_row(
+            "SELECT value FROM settings WHERE key='common_config_codex'",
+            [],
+            |r| r.get(0),
+        )
+        .unwrap();
+    assert_eq!(common, COMMON_CONFIG);
+    let rows = conn
+        .prepare("SELECT id,server_config,enabled_codex FROM mcp_servers ORDER BY id")
+        .unwrap()
+        .query_map([], |r| {
+            Ok((
+                r.get::<_, String>(0)?,
+                r.get::<_, String>(1)?,
+                r.get::<_, i64>(2)?,
+            ))
+        })
+        .unwrap()
+        .collect::<Result<Vec<_>, _>>()
+        .unwrap();
+    assert_eq!(
+        rows,
+        vec![
+            (
+                "disabled".into(),
+                r#"{"command":"synthetic-disabled"}"#.into(),
+                0
+            ),
+            ("media".into(), r#"{"command":"synthetic-media"}"#.into(), 1)
+        ]
+    );
+    let prompt: String = conn
+        .query_row(
+            "SELECT content FROM prompts WHERE id='user-prompt'",
+            [],
+            |r| r.get(0),
+        )
+        .unwrap();
+    assert_eq!(prompt, "keep me");
+    let proxy_count: i64 = conn
+        .query_row(
+            "SELECT count(*) FROM proxy_request_logs WHERE request_id='proxy-record'",
+            [],
+            |r| r.get(0),
+        )
+        .unwrap();
+    assert_eq!(proxy_count, 1);
+}
+
+#[test]
+fn usb_upgrade_schema_v10_preserves_provider_mcp_and_settings() {
+    let conn = old_database();
+    Database::create_tables_on_conn(&conn).unwrap();
+    Database::apply_schema_migrations_on_conn(&conn).unwrap();
+    assert_eq!(Database::get_user_version(&conn).unwrap(), SCHEMA_VERSION);
+    assert_user_rows_preserved(&conn);
+    let flags: (i64,i64,i64,i64,i64) = conn.query_row("SELECT enabled_grokbuild,enabled_mcode,enabled_agy,enabled_kimi,enabled_omp FROM mcp_servers WHERE id='media'", [], |r| Ok((r.get(0)?,r.get(1)?,r.get(2)?,r.get(3)?,r.get(4)?))).unwrap();
+    assert_eq!(flags, (0, 0, 0, 0, 0));
+    let rollup: (i64,String) = conn.query_row("SELECT request_count,total_cost_usd FROM usage_daily_rollups WHERE provider_id='404token-sub2api'", [], |r| Ok((r.get(0)?,r.get(1)?))).unwrap();
+    assert_eq!(rollup, (3, "0.25".into()));
+    // Official v15->v16 deliberately clears derived Codex usage for re-import.
+    let derived: i64 = conn
+        .query_row(
+            "SELECT count(*) FROM proxy_request_logs WHERE request_id='derived-codex'",
+            [],
+            |r| r.get(0),
+        )
+        .unwrap();
+    assert_eq!(derived, 0);
+}
+
+#[test]
+fn usb_upgrade_schema_migration_is_repeatable() {
+    let conn = old_database();
+    Database::create_tables_on_conn(&conn).unwrap();
+    for _ in 0..2 {
+        Database::apply_schema_migrations_on_conn(&conn).unwrap();
+    }
+    assert_eq!(Database::get_user_version(&conn).unwrap(), SCHEMA_VERSION);
+    assert_user_rows_preserved(&conn);
+}
+
+#[test]
+fn usb_upgrade_schema_rejects_newer_database_without_mutation() {
+    let conn = old_database();
+    Database::set_user_version(&conn, SCHEMA_VERSION + 1).unwrap();
+    assert!(Database::apply_schema_migrations_on_conn(&conn).is_err());
+    assert_eq!(
+        Database::get_user_version(&conn).unwrap(),
+        SCHEMA_VERSION + 1
+    );
+    assert_user_rows_preserved(&conn);
+    assert!(!Database::has_column(&conn, "usage_daily_rollups", "request_model").unwrap());
+}
+
+#[test]
+fn usb_upgrade_schema_late_failure_rolls_back_to_v10() {
+    let conn = old_database();
+    conn.execute_batch("CREATE TRIGGER stop_derived_delete BEFORE DELETE ON proxy_request_logs WHEN OLD.data_source='codex_session' BEGIN SELECT RAISE(ABORT,'synthetic migration failure'); END;").unwrap();
+    assert!(Database::apply_schema_migrations_on_conn(&conn).is_err());
+    assert_eq!(Database::get_user_version(&conn).unwrap(), 10);
+    assert_user_rows_preserved(&conn);
+    assert!(!Database::has_column(&conn, "usage_daily_rollups", "request_model").unwrap());
+    let derived: i64 = conn
+        .query_row(
+            "SELECT count(*) FROM proxy_request_logs WHERE request_id='derived-codex'",
+            [],
+            |r| r.get(0),
+        )
+        .unwrap();
+    assert_eq!(derived, 1);
+}

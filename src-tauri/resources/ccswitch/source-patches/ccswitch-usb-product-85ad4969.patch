+/// Validate the manager-supplied USB home without consulting global overrides.
+pub(crate) fn usb_codex_home_for_mode(
+    mode: Option<&str>,
+    home: Option<&std::ffi::OsStr>,
+) -> Option<PathBuf> {
+    if mode != Some("usb") {
+        return None;
+    }
+    let path = PathBuf::from(home?);
+    if !path.is_absolute()
+        || path.file_name().is_none()
+        || path
+            .components()
+            .any(|part| matches!(part, std::path::Component::ParentDir))
+    {
+        return None;
+    }
+    // The Codex live directory and switcher state must never be the same home.
+    let directory_name = path.file_name()?;
+    let is_state_home = if cfg!(windows) {
+        directory_name
+            .to_str()
+            .is_some_and(|name| name.eq_ignore_ascii_case("usb-ccswitch-home-v4"))
+    } else {
+        directory_name == std::ffi::OsStr::new("usb-ccswitch-home-v4")
+    };
+    if is_state_home {
+        return None;
+    }
+    Some(path)
+}
+
+fn usb_app_config_dir_for_mode(
+    mode: Option<&str>,
+    home: Option<&std::ffi::OsStr>,
+) -> Option<PathBuf> {
+    let codex = usb_codex_home_for_mode(mode, home)?;
+    Some(codex.parent()?.join("usb-ccswitch-home-v4"))
+}
+
+/// A dedicated local USB v4 store. Never migrate the user's shared 3.x database.
+pub(crate) fn usb_app_config_dir() -> Option<PathBuf> {
+    usb_app_config_dir_for_mode(
+        std::env::var("CODEX_USB_CCSWITCH_MODE").ok().as_deref(),
+        std::env::var_os("CCSWITCH_USB_CODEX_HOME").as_deref(),
+    )
+}
+
+pub(crate) fn validate_usb_runtime_home() -> Result<(), AppError> {
+    if std::env::var("CODEX_USB_CCSWITCH_MODE").ok().as_deref() == Some("usb")
+        && usb_app_config_dir().is_none()
+    {
+        return Err(AppError::Config(
+            "USB Codex home must be an absolute dedicated directory".into(),
+        ));
+    }
+    Ok(())
+}
+

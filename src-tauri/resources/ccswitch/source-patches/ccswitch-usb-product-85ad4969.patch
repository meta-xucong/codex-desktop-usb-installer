+#[cfg(target_os = "windows")]
+fn inspect_provider(provider: &Provider) -> Result<ConfigInspection, BridgeFailure> {
+    if provider.id != crate::services::provider::USB_404TOKEN_PROVIDER_ID {
+        return Err(BridgeFailure::new("provider-mismatch"));
+    }
+    let settings = provider
+        .settings_config
+        .as_object()
+        .ok_or_else(|| BridgeFailure::new("provider-config-invalid"))?;
+    let has_device_key = settings
+        .get("auth")
+        .and_then(|auth| auth.get("OPENAI_API_KEY"))
+        .and_then(Value::as_str)
+        .is_some_and(|key| !key.trim().is_empty());
+    if !has_device_key {
+        return Err(BridgeFailure::new("device-key-missing"));
+    }
+    validate_settings_catalog_keys(settings)?;
+    let config = settings
+        .get("config")
+        .and_then(Value::as_str)
+        .ok_or_else(|| BridgeFailure::new("provider-config-invalid"))?;
+    inspect_usb_config(config, true)
+}
+
+#[cfg(target_os = "windows")]
+fn inspect_live_usb_config(config: &str) -> Result<ConfigInspection, BridgeFailure> {
+    let document = config
+        .parse::<DocumentMut>()
+        .map_err(|_| BridgeFailure::new("provider-config-invalid"))?;
+    validate_catalog_keys(&document, true)?;
+    if document.get("model_provider").is_none() {
+        // A fresh Codex home may contain general preferences but no provider.
+        // Preserve those preferences; a distinct explicit model remains a conflict.
+        return Ok(ConfigInspection {
+            model: explicit_model(&document)?,
+        });
+    }
+    inspect_usb_config(config, true)
+}
+
+#[cfg(target_os = "windows")]
+fn inspect_usb_config(
+    config: &str,
+    allow_managed_catalog: bool,
+) -> Result<ConfigInspection, BridgeFailure> {
+    let document = config
+        .parse::<DocumentMut>()
+        .map_err(|_| BridgeFailure::new("provider-config-invalid"))?;
+    validate_catalog_keys(&document, allow_managed_catalog)?;
+    if [
+        "profile",
+        "model_reasoning_effort",
+        "model_reasoning_summary",
+        "service_tier",
+    ]
+    .iter()
+    .any(|key| document.get(key).is_some())
+    {
+        return Err(BridgeFailure::new("unverified-model-options"));
+    }
+
+    let model_provider = document
+        .get("model_provider")
+        .and_then(|item| item.as_str())
+        .map(str::trim)
+        .filter(|id| !id.is_empty())
+        .ok_or_else(|| BridgeFailure::new("endpoint-mismatch"))?;
+    let provider_table = document
+        .get("model_providers")
+        .and_then(|item| item.as_table_like())
+        .and_then(|table| table.get(model_provider))
+        .and_then(|item| item.as_table_like())
+        .ok_or_else(|| BridgeFailure::new("endpoint-mismatch"))?;
+    let base_url = provider_table
+        .get("base_url")
+        .and_then(|item| item.as_str())
+        .map(str::trim)
+        .map(|url| url.trim_end_matches('/'))
+        .filter(|url| !url.is_empty())
+        .ok_or_else(|| BridgeFailure::new("endpoint-mismatch"))?;
+    let inline_bearer = provider_table
+        .get("experimental_bearer_token")
+        .and_then(|v| v.as_str());
+    let native_live = model_provider == crate::live::project::codex::ROUTE_ID;
+    let expected_key = std::env::var("CCSWITCH_404TOKEN_DEVICE_KEY")
+        .ok()
+        .map(|key| key.trim().to_owned());
+    let valid_credential = if native_live {
+        inline_bearer.filter(|key| !key.is_empty())
+            == expected_key.as_deref().filter(|key| !key.is_empty())
+            && expected_key.as_deref().is_some_and(|key| !key.is_empty())
+            && provider_table
+                .get("requires_openai_auth")
+                .and_then(|v| v.as_bool())
+                .is_some()
+    } else {
+        model_provider == "404token"
+            && inline_bearer.is_none()
+            && provider_table
+                .get("requires_openai_auth")
+                .and_then(|v| v.as_bool())
+                == Some(true)
+    };
+    if base_url != crate::services::provider::USB_404TOKEN_BASE_URL
+        || provider_table.get("wire_api").and_then(|v| v.as_str()) != Some("responses")
+        || !valid_credential
+        || [
+            "env_key",
+            "http_headers",
+            "env_http_headers",
+            "auth",
+            "aws",
+            "query_params",
+        ]
+        .iter()
+        .any(|key| provider_table.get(key).is_some())
+    {
+        return Err(BridgeFailure::new("endpoint-mismatch"));
+    }
+
+    let model = explicit_model(&document)?;
+    Ok(ConfigInspection { model })
+}
+
+#[cfg(target_os = "windows")]
+fn explicit_model(document: &DocumentMut) -> Result<Option<String>, BridgeFailure> {
+    let Some(item) = document.get("model") else {
+        return Ok(None);
+    };
+    let model = item
+        .as_str()
+        .ok_or_else(|| BridgeFailure::new("provider-config-invalid"))?
+        .trim();
+    if model.is_empty() {
+        return Ok(None);
+    }
+    validate_bounded_text(model, MAX_MODEL_BYTES)
+        .map_err(|_| BridgeFailure::new("provider-config-invalid"))?;
+    Ok(Some(model.to_string()))
+}
+
+#[cfg(target_os = "windows")]
+fn validate_expected_codex_home() -> Result<std::path::PathBuf, BridgeFailure> {
+    let expected = std::env::var_os("CODEX_USB_EXPECTED_CODEX_HOME")
+        .map(std::path::PathBuf::from)
+        .filter(|p| p.is_absolute())
+        .ok_or_else(|| BridgeFailure::new("codex-home-conflict"))?;
+    reject_reparse_ancestors(&expected)?;
+    let expected =
+        fs::canonicalize(&expected).map_err(|_| BridgeFailure::new("codex-home-conflict"))?;
+    for path in [get_codex_config_path(), get_codex_auth_path()] {
+        let parent = path
+            .parent()
+            .ok_or_else(|| BridgeFailure::new("codex-home-conflict"))?;
+        reject_reparse_ancestors(parent)?;
+        if fs::canonicalize(parent).ok().as_ref() != Some(&expected) {
+            return Err(BridgeFailure::new("codex-home-conflict"));
+        }
+    }
+    Ok(expected)
+}
+
+#[cfg(target_os = "windows")]
+fn reject_reparse_ancestors(path: &std::path::Path) -> Result<(), BridgeFailure> {
+    use std::os::windows::fs::MetadataExt;
+    for ancestor in path.ancestors() {
+        match fs::symlink_metadata(ancestor) {
+            Ok(meta) if meta.file_attributes() & 0x400 != 0 => {
+                return Err(BridgeFailure::new("config-path-unsafe"))
+            }
+            Ok(_) => {}
+            Err(e) if e.kind() == io::ErrorKind::NotFound => {}
+            Err(_) => return Err(BridgeFailure::new("live-read-failed")),
+        }
+    }
+    Ok(())
+}
+
+#[cfg(target_os = "windows")]
+fn bounded_regular_bytes(path: &std::path::Path) -> Result<Option<Vec<u8>>, BridgeFailure> {
+    reject_reparse_ancestors(path)?;
+    let meta = match fs::symlink_metadata(path) {
+        Ok(meta) => meta,
+        Err(e) if e.kind() == io::ErrorKind::NotFound => return Ok(None),
+        Err(_) => return Err(BridgeFailure::new("live-read-failed")),
+    };
+    if !meta.is_file() || meta.len() > MAX_CONFIG_BYTES as u64 {
+        return Err(BridgeFailure::new("live-config-too-large"));
+    }
+    let mut bytes = Vec::new();
+    fs::File::open(path)
+        .map_err(|_| BridgeFailure::new("live-read-failed"))?
+        .take((MAX_CONFIG_BYTES + 1) as u64)
+        .read_to_end(&mut bytes)
+        .map_err(|_| BridgeFailure::new("live-read-failed"))?;
+    if bytes.len() > MAX_CONFIG_BYTES {
+        return Err(BridgeFailure::new("live-config-too-large"));
+    }
+    Ok(Some(bytes))
+}
+
+#[cfg(target_os = "windows")]
+fn validate_owned_catalog(value: &str) -> Result<(), BridgeFailure> {
+    let home = validate_expected_codex_home()?;
+    let expected = home.join("codex-usb-native-model-catalog.json");
+    let actual = std::path::PathBuf::from(value);
+    if !actual.is_absolute() || actual.file_name() != expected.file_name() {
+        return Err(BridgeFailure::new("catalog-conflict"));
+    }
+    reject_reparse_ancestors(&actual)?;
+    if fs::canonicalize(&actual).ok() != fs::canonicalize(&expected).ok() || !expected.exists() {
+        return Err(BridgeFailure::new("catalog-conflict"));
+    }
+    let bytes =
+        bounded_regular_bytes(&actual)?.ok_or_else(|| BridgeFailure::new("catalog-conflict"))?;
+    let catalog: Value =
+        serde_json::from_slice(&bytes).map_err(|_| BridgeFailure::new("catalog-conflict"))?;
+    if catalog.get("identity").and_then(Value::as_str) != Some("404token-unified-api-internal") {
+        return Err(BridgeFailure::new("catalog-conflict"));
+    }
+    Ok(())
+}
+
+#[cfg(target_os = "windows")]
+fn read_live_config_snapshot() -> Result<LiveConfigSnapshot, BridgeFailure> {
+    // Refuse the ordinary/shared CC Switch store before any DB initialization.
+    if std::env::var("CODEX_USB_CCSWITCH_MODE").ok().as_deref() != Some("usb")
+        || crate::config::usb_app_config_dir().is_none()
+    {
+        return Err(BridgeFailure::new("codex-home-conflict"));
+    }
+    let expected_home = validate_expected_codex_home()?;
+    let usb_home = std::env::var_os("CCSWITCH_USB_CODEX_HOME")
+        .map(std::path::PathBuf::from)
+        .ok_or_else(|| BridgeFailure::new("codex-home-conflict"))?;
+    reject_reparse_ancestors(&usb_home)?;
+    if fs::canonicalize(&usb_home).ok().as_ref() != Some(&expected_home) {
+        return Err(BridgeFailure::new("codex-home-conflict"));
+    }
+    let config_path = get_codex_config_path();
+    let (config_text, config_sha256) = if let Some(bytes) = bounded_regular_bytes(&config_path)? {
+        if bytes.len() > MAX_CONFIG_BYTES {
+            return Err(BridgeFailure::new("live-config-too-large"));
+        }
+        let text = String::from_utf8(bytes.clone())
+            .map_err(|_| BridgeFailure::new("live-config-invalid"))?;
+        (Some(text), Some(sha256_hex(&bytes)))
+    } else {
+        (None, None)
+    };
+
+    let auth_path = get_codex_auth_path();
+    let auth_sha256 = if let Some(bytes) = bounded_regular_bytes(&auth_path)? {
+        if bytes.len() > MAX_CONFIG_BYTES {
+            return Err(BridgeFailure::new("live-auth-too-large"));
+        }
+        Some(sha256_hex(&bytes))
+    } else {
+        None
+    };
+
+    Ok(LiveConfigSnapshot {
+        config_text,
+        config_sha256,
+        auth_sha256,
+    })
+}
+
+#[cfg(target_os = "windows")]
+fn provider_with_selected_model(
+    provider: &Provider,
+    source_config: Option<&str>,
+    requested_model: &str,
+) -> Result<Provider, BridgeFailure> {
+    let mut updated = provider.clone();
+    let settings = updated
+        .settings_config
+        .as_object_mut()
+        .ok_or_else(|| BridgeFailure::new("provider-config-invalid"))?;
+    let provider_config = settings
+        .get("config")
+        .and_then(Value::as_str)
+        .map(str::to_owned)
+        .ok_or_else(|| BridgeFailure::new("provider-config-invalid"))?;
+    // 4.x provider rows own routing/model fields, not a snapshot of live
+    // plugins/MCP/permissions. Never merge the live file back into this row.
+    let _ = source_config;
+    let mut document = provider_config
+        .parse::<DocumentMut>()
+        .map_err(|_| BridgeFailure::new("provider-config-invalid"))?;
+    validate_catalog_keys(&document, true)?;
+    document.as_table_mut().remove(MANAGED_MODEL_CATALOG_KEY);
+    let current_model = explicit_model(&document)?;
+    if current_model
+        .as_deref()
+        .is_some_and(|model| model != requested_model)
+    {
+        return Err(BridgeFailure::new("user-model-conflict"));
+    }
+    document["model"] = toml_edit::value(requested_model);
+    let config_text = document.to_string();
+    // The removed owned pointer must not leave an empty legacy marker block.
+    let config_text = config_text
+        .split_inclusive('\n')
+        .filter(|line| {
+            !matches!(
+                line.trim(),
+                "# BEGIN CODEX-USB-NATIVE-MODEL-CATALOG v1"
+                    | "# END CODEX-USB-NATIVE-MODEL-CATALOG v1"
+            )
+        })
+        .collect::<String>();
+    settings.insert("config".to_string(), Value::String(config_text));
+    // The manager-owned root must never become a provider DB field, even if
+    // an older record stored it outside the TOML string.
+    settings.remove(MANAGED_MODEL_CATALOG_KEY);
+    Ok(updated)
+}
+
+#[cfg(target_os = "windows")]
+fn validate_settings_catalog_keys(settings: &Map<String, Value>) -> Result<(), BridgeFailure> {
+    for (key, value) in settings {
+        if key == MANAGED_MODEL_CATALOG_KEY {
+            let path = value
+                .as_str()
+                .ok_or_else(|| BridgeFailure::new("catalog-conflict"))?;
+            validate_owned_catalog(path)?;
+            continue;
+        }
+        if is_unrelated_catalog_key(key) {
+            return Err(BridgeFailure::new("catalog-conflict"));
+        }
+    }
+    Ok(())
+}
+
+#[cfg(target_os = "windows")]
+fn validate_catalog_keys(
+    document: &DocumentMut,
+    allow_managed_catalog: bool,
+) -> Result<(), BridgeFailure> {
+    for (key, item) in document.as_table().iter() {
+        let key = key.to_string();
+        if key == MANAGED_MODEL_CATALOG_KEY {
+            if !allow_managed_catalog {
+                return Err(BridgeFailure::new("catalog-conflict"));
+            }
+            let path = item
+                .as_str()
+                .ok_or_else(|| BridgeFailure::new("catalog-conflict"))?;
+            validate_owned_catalog(path)?;
+            continue;
+        }
+        if is_unrelated_catalog_key(&key) {
+            return Err(BridgeFailure::new("catalog-conflict"));
+        }
+    }
+    Ok(())
+}
+
+fn is_unrelated_catalog_key(key: &str) -> bool {
+    let normalized = key.to_ascii_lowercase();
+    normalized == "catalog"
+        || normalized == "models"
+        || normalized == "modelcatalog"
+        || normalized == "model_catalog"
+        || normalized == "modelaliases"
+        || normalized == "model_aliases"
+        || (normalized.contains("catalog") && normalized != MANAGED_MODEL_CATALOG_KEY)
+}
+
+#[cfg(target_os = "windows")]
+fn reject_proxy_takeover(state: &AppState) -> Result<(), BridgeFailure> {
+    // Old live backups are frozen in 4.x and are not the source of truth.
+    // Inspect current mode/attachment, not legacy backup presence.
+    let mode = crate::mode::state::mode_state(
+        &crate::live::engine::DeviceStore::for_device(),
+        AppType::Codex.as_str(),
+    )
+    .map_err(|_| BridgeFailure::new("mode-state-invalid"))?;
+    if mode.is_proxy() || mode.attached {
+        return Err(BridgeFailure::new("proxy-takeover-unsupported"));
+    }
+    let _ = state;
+    Ok(())
+}
+
+fn canonicalize_json(value: &Value) -> Value {
+    match value {
+        Value::Object(object) => {
+            let mut keys: Vec<&String> = object.keys().collect();
+            keys.sort_unstable();
+            let mut sorted = Map::new();
+            for key in keys {
+                if let Some(value) = object.get(key) {
+                    sorted.insert(key.clone(), canonicalize_json(value));
+                }
+            }
+            Value::Object(sorted)
+        }
+        Value::Array(values) => Value::Array(values.iter().map(canonicalize_json).collect()),
+        other => other.clone(),
+    }
+}
+
+fn sha256_hex(bytes: &[u8]) -> String {
+    let mut digest = Sha256::new();
+    digest.update(bytes);
+    digest
+        .finalize()
+        .iter()
+        .map(|byte| format!("{byte:02x}"))
+        .collect()
+}
+
+fn response_for_failure(request_id: &str, failure: BridgeFailure) -> UsbModelSelectionResponse {
+    UsbModelSelectionResponse {
+        schema_version: 3,
+        request_id: request_id.to_string(),
+        ok: false,
+        code: failure.code,
+        revision: failure.revision,
+        selected_model: failure.selected_model,
+        config_sha256: failure.config_sha256,
+        applied: failure.applied,
+    }
+}
+
+fn write_response(response: &UsbModelSelectionResponse) -> bool {
+    let serialized = serde_json::to_vec(response).unwrap_or_else(|_| {
+        br#"{"schemaVersion":3,"requestId":"","ok":false,"code":"response-serialization-failed","revision":null,"selectedModel":null,"configSha256":null,"applied":false}"#.to_vec()
+    });
+    let body = if serialized.len() <= MAX_RESPONSE_BYTES {
+        serialized
+    } else {
+        br#"{"schemaVersion":3,"requestId":"","ok":false,"code":"response-too-large","revision":null,"selectedModel":null,"configSha256":null,"applied":false}"#.to_vec()
+    };
+    let mut stdout = io::stdout().lock();
+    stdout.write_all(&body).and_then(|_| stdout.flush()).is_ok()
+}

+        let value: serde_json::Value = serde_json::from_str(&stored)
+            .map_err(|_| AppError::Config("USB provider settings are invalid".into()))?;
+        if &value != before {
+            return Err(AppError::Config("USB provider revision changed".into()));
+        }
+        let ids: Vec<String> = {
+            let mut statement = tx
+                .prepare("SELECT id FROM providers WHERE app_type = 'codex' AND is_current = 1")
+                .map_err(|_| AppError::Database("USB selection snapshot failed".into()))?;
+            let values = statement
+                .query_map([], |row| row.get::<_, String>(0))
+                .map_err(|_| AppError::Database("USB selection snapshot failed".into()))?;
+            values
+                .collect::<Result<Vec<_>, _>>()
+                .map_err(|_| AppError::Database("USB selection snapshot failed".into()))?
+        };
+        let expected = expected_current
+            .into_iter()
+            .map(str::to_owned)
+            .collect::<Vec<_>>();
+        if ids != expected {
+            return Err(AppError::Config(
+                "USB current provider revision changed".into(),
+            ));
+        }
+        let encoded = serde_json::to_string(after)

+impl ProviderService {
+    pub(crate) fn provider_from_usb_404token_key(key: &str) -> Provider {
+        let mut provider = Provider::with_id(
+            USB_404TOKEN_PROVIDER_ID.into(),
+            "404TOKEN（unified-api-internal）".into(),
+            serde_json::json!({ "auth": { "OPENAI_API_KEY": key }, "config": format!(r#"model_provider = "404token"
+disable_response_storage = true
+[model_providers.404token]
+name = "404TOKEN unified-api-internal"
+base_url = "{USB_404TOKEN_BASE_URL}"
+wire_api = "responses"
+requires_openai_auth = true
+"#) }),
+            Some("https://404token.xyz".into()),
+        );
+        provider.category = Some("aggregator".into());
+        provider.icon = Some("openai".into());
+        provider.icon_color = Some("#00A67E".into());
+        provider.notes =
+            Some("USB device binding; models are selected only after manager verification".into());
+        provider
+    }
+
+    pub fn bootstrap_usb_404token_from_environment(state: &AppState) -> Result<bool, AppError> {
+        let Ok(key) = std::env::var(DEVICE_KEY_ENV) else {
+            return Ok(false);
+        };
+        let key = key.trim();
+        if key.is_empty() {
+            return Ok(false);
+        }
+        crate::config::validate_usb_runtime_home()?;
+        if crate::config::usb_app_config_dir().is_none() {
+            return Err(AppError::Config(
+                "USB credential requires isolated USB mode".into(),
+            ));
+        }
+        let _usb_guard = crate::usb_model_selection::acquire_codex_guard()?;
+        // Validate acknowledgement path before any database or live mutation.
+        let handoff = Handoff::from_environment()?;
+        let _mode_guard = crate::mode::controller::lock_settled_blocking(state, &AppType::Codex)?;
+        if crate::mode::current::is_proxy(&AppType::Codex) {
+            return Err(AppError::Config(
+                "USB bootstrap will not replace an active routed Codex configuration".into(),
+            ));
+        }
+        in_bootstrap(|| {
+            let mut provider = Self::provider_from_usb_404token_key(key);
+            Self::validate_provider_settings(&AppType::Codex, &provider)?;
+            Self::set_provider_live_config_managed(&mut provider, false);
+            state.db.prepare_usb_codex_provider(&provider)?;
+            let providers = state.db.get_all_providers(AppType::Codex.as_str())?;
+            let stored = providers
+                .get(USB_404TOKEN_PROVIDER_ID)
+                .ok_or_else(|| AppError::Config("USB provider was not persisted".into()))?;
+            validate_protected_provider(stored)?;
+            // Official 4.x operation commits config/auth/catalog/pointer and
+            // records recovery intent. No old MCP resync or full-file rollback.
+            let projection = crate::usb_model_selection::prepare_usb_bootstrap_projection(stored)?;
+            validate_existing_bound_route_auth()?;
+            projection.verify_before_write()?;
+            Self::switch_codex_direct(state, &projection.provider, &providers)?;
+            projection.verify_after_write()?;
+            if !Self::usb_404token_live_readback_matches(state, key)? {
+                return Err(AppError::Config(
+                    "USB activation was not verified; no acknowledgement issued".into(),
+                ));
+            }
+            if let Some(handoff) = handoff {
+                handoff.acknowledge(key)?;
+            }
+            log::debug!("CODEX_USB_V4_FIELD_WRITE_V1: verified official field-write activation");
+            Ok(true)
+        })
+    }
+
+    pub(crate) fn usb_404token_live_readback_matches(
+        state: &AppState,
+        key: &str,
+    ) -> Result<bool, AppError> {
+        let current = crate::mode::current::provider_for(
+            &state.db,
+            &AppType::Codex,
+            crate::mode::current::Purpose::Direct,
+        )?;
+        if current.as_deref() != Some(USB_404TOKEN_PROVIDER_ID) {
+            return Ok(false);
+        }
+        let text = crate::codex_config::read_codex_config_text()?;
+        let doc: toml::Value = toml::from_str(&text)
+            .map_err(|_| AppError::Config("USB live configuration invalid".into()))?;
+        let route_id = crate::live::project::codex::ROUTE_ID;
+        let table = doc.get("model_providers").and_then(|v| v.get(route_id));
+        Ok(bound_route_has_no_auth_overrides(&doc, key)
+            && doc.get("model_provider").and_then(toml::Value::as_str) == Some(route_id)
+            && table
+                .and_then(|v| v.get("base_url"))
+                .and_then(toml::Value::as_str)
+                .is_some_and(|v| v.trim_end_matches('/') == USB_404TOKEN_BASE_URL)
+            && table
+                .and_then(|v| v.get("experimental_bearer_token"))
+                .and_then(toml::Value::as_str)
+                == Some(key)
+            && table
+                .and_then(|v| v.get("wire_api"))
+                .and_then(toml::Value::as_str)
+                == Some("responses"))
+    }
+}

+import { render, screen, waitFor } from "@testing-library/react";
+import userEvent from "@testing-library/user-event";
+import { describe, expect, it, vi } from "vitest";
+import { ModelInputWithFetch } from "@/components/providers/forms/shared/ModelInputWithFetch";
+
+describe("ModelInputWithFetch", () => {
+  it("shows the collapsed display name but writes the selected upstream ID", async () => {
+    const onChange = vi.fn();
+    const user = userEvent.setup();
+
+    render(
+      <ModelInputWithFetch
+        id="model"
+        value=""
+        onChange={onChange}
+        fetchedModels={[
+          {
+            id: "gpt-6-2026-09-20",
+            displayName: "gpt-6",
+            ownedBy: "openai",
+          },
+        ]}
+        isLoading={false}
+      />,
+    );
+
+    await user.click(screen.getByRole("button"));
+    const option = await screen.findByRole("menuitem", { name: "gpt-6" });
+    await user.click(option);
+
+    await waitFor(() =>
+      expect(onChange).toHaveBeenCalledWith("gpt-6-2026-09-20"),
+    );
+  });
+});

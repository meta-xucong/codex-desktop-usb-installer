+    /// Narrow Codex USB transaction. The callback may write only the already
+    /// validated local files/settings; it must not re-enter this DB connection.
+    pub(crate) fn apply_usb_model_selection_transaction<F>(
+        &self, before: &serde_json::Value, after: &serde_json::Value,
+        expected_current: Option<&str>, write_live: F,
+    ) -> Result<(), AppError>
+    where F: FnOnce() -> Result<(), AppError> {
+        const ID: &str = "404token-sub2api";
+        let _codex_guard = crate::usb_model_selection::acquire_codex_guard()?;
+        if expected_current.is_some_and(|id| id != ID) {
+            return Err(AppError::Config("USB selection would replace a different provider".into()));
+        }
+        let mut conn = lock_conn!(self.conn);
+        let tx = conn.transaction().map_err(|_| AppError::Database("USB selection transaction failed".into()))?;
+        let stored: String = tx.query_row(
+            "SELECT settings_config FROM providers WHERE app_type = 'codex' AND id = ?1",
+            params![ID], |row| row.get(0),
+        ).map_err(|_| AppError::Database("USB provider is unavailable".into()))?;
+        let value: serde_json::Value = serde_json::from_str(&stored)
+            .map_err(|_| AppError::Config("USB provider settings are invalid".into()))?;
+        if &value != before { return Err(AppError::Config("USB provider revision changed".into())); }
+        let ids: Vec<String> = {
+            let mut statement = tx.prepare("SELECT id FROM providers WHERE app_type = 'codex' AND is_current = 1")
+                .map_err(|_| AppError::Database("USB selection snapshot failed".into()))?;
+            let values = statement.query_map([], |row| row.get::<_,String>(0))
+                .map_err(|_| AppError::Database("USB selection snapshot failed".into()))?;
+            values.collect::<Result<Vec<_>,_>>()
+                .map_err(|_| AppError::Database("USB selection snapshot failed".into()))?
+        };
+        let expected = expected_current.into_iter().map(str::to_owned).collect::<Vec<_>>();
+        if ids != expected { return Err(AppError::Config("USB current provider revision changed".into())); }
+        let encoded = serde_json::to_string(after).map_err(|_| AppError::Config("USB settings serialization failed".into()))?;
+        tx.execute("UPDATE providers SET settings_config = ?1, is_current = 1 WHERE app_type = 'codex' AND id = ?2",
+            params![encoded,ID]).map_err(|_| AppError::Database("USB selection staging failed".into()))?;
+        write_live()?;
+        tx.commit().map_err(|_| AppError::Database("USB selection commit failed".into()))
+    }

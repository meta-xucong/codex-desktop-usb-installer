+
+/// Remove MCP IDs explicitly managed by the CCSwitch database before merging
+/// the post-sync live table. The database sync is authoritative for managed
+/// IDs: enabled definitions come from sync, while disabled IDs stay removed.
+/// Unmanaged servers already present in the pre-switch snapshot are retained.
+pub(crate) fn remove_managed_codex_mcp_servers(
+    provider: &mut Provider,
+    managed_ids: &[String],
+) -> Result<(), AppError> {
+    let target_config = provider
+        .settings_config
+        .get("config")
+        .and_then(Value::as_str)
+        .ok_or_else(|| AppError::Config("Codex 供应商配置缺少 config TOML".into()))?;
+    let mut target = target_config
+        .parse::<DocumentMut>()
+        .map_err(|error| AppError::Config(format!("目标 Codex config.toml 无效: {error}")))?;
+    if let Some(servers) = target
+        .get_mut("mcp_servers")
+        .and_then(toml_edit::Item::as_table_like_mut)
+    {
+        for id in managed_ids {
+            servers.remove(id);
+        }
+    }
+    let settings = provider
+        .settings_config
+        .as_object_mut()
+        .ok_or_else(|| AppError::Config("Codex 供应商配置必须是 JSON 对象".into()))?;
+    settings.insert("config".to_string(), Value::String(target.to_string()));
+    Ok(())
+}
+
+/// Rebuild database-managed Codex MCP entries from the database snapshot.
+/// This is used when the normal live sync fails partway through: the partially
+/// synchronized live file cannot be treated as authoritative for managed IDs.
+pub(crate) fn apply_database_codex_mcp_servers(
+    provider: &mut Provider,
+    servers: &indexmap::IndexMap<String, crate::app_config::McpServer>,
+) -> Result<(), AppError> {
+    log::debug!("CODEX_USB_MCP_SYNC_FAILURE_RECOVERY_V1: managed Codex MCP entries rebuilt from database");
+    let managed_ids = servers.keys().cloned().collect::<Vec<_>>();
+    remove_managed_codex_mcp_servers(provider, &managed_ids)?;
+
+    let target_config = provider
+        .settings_config
+        .get("config")
+        .and_then(Value::as_str)
+        .ok_or_else(|| AppError::Config("Codex 供应商配置缺少 config TOML".into()))?;
+    let mut target = target_config
+        .parse::<DocumentMut>()
+        .map_err(|error| AppError::Config(format!("目标 Codex config.toml 无效: {error}")))?;
+    for (id, server) in servers {
+        if !server.apps.codex {
+            continue;
+        }
+        match crate::mcp::codex_server_to_toml_table(&server.server) {
+            Ok(table) => {
+                target["mcp_servers"][id] = toml_edit::Item::Table(table);
+            }
+            Err(error) => {
+                // Keep the database sync error as the primary failure and omit
+                // this invalid entry rather than restoring stale live content.
+                log::warn!("Skipping invalid database-managed Codex MCP '{id}' during recovery: {error}");
+            }
+        }
+    }
+
+    let settings = provider
+        .settings_config
+        .as_object_mut()
+        .ok_or_else(|| AppError::Config("Codex 供应商配置必须是 JSON 对象".into()))?;
+    settings.insert("config".to_string(), Value::String(target.to_string()));
+    Ok(())
+}
+
+fn preserve_codex_mcp_servers(
+    target_config: &str,
+    active_config: &str,
+) -> Result<String, AppError> {
+    fn parse_config(text: &str, label: &str) -> Result<DocumentMut, AppError> {
+        if text.trim().is_empty() {
+            return Ok(DocumentMut::new());
+        }
+        text.parse::<DocumentMut>()
+            .map_err(|error| AppError::Config(format!("{label} Codex config.toml 无效: {error}")))
+    }
+
+    fn validate_mcp_table(document: &DocumentMut, label: &str) -> Result<(), AppError> {
+        if let Some(item) = document.get("mcp_servers") {
+            if item.as_table_like().is_none() {
+                return Err(AppError::Config(format!(
+                    "{label} config.toml 的 mcp_servers 必须是 TOML table"
+                )));
+            }
+        }
+        Ok(())
+    }
+
+    let mut target = parse_config(target_config, "目标")?;
+    let active = parse_config(active_config, "当前")?;
+    validate_mcp_table(&active, "当前")?;
+    validate_mcp_table(&target, "目标")?;
+
+    if let Some(active_servers) = active
+        .get("mcp_servers")
+        .and_then(toml_edit::Item::as_table_like)
+    {
+        match target.get_mut("mcp_servers") {
+            None => target["mcp_servers"] = active["mcp_servers"].clone(),
+            Some(target_item) => {
+                let target_servers = target_item.as_table_like_mut().ok_or_else(|| {
+                    AppError::Config("目标 config.toml 的 mcp_servers 必须是 TOML table".into())
+                })?;
+                for (server_id, server_config) in active_servers.iter() {
+                    if target_servers.get(server_id).is_none() {
+                        target_servers.insert(server_id, server_config.clone());
+                    }
+                }
+            }
+        }
+    }
+
+    // Validate the merged document before any provider selection or live-file
+    // mutation. DocumentMut serialization should be valid, but keep this
+    // boundary explicit because the result is persisted as Codex config.
+    toml::from_str::<toml::Table>(&target.to_string())
+        .map_err(|error| AppError::Config(format!("合并后的 Codex config.toml 无效: {error}")))?;
+    Ok(target.to_string())
 }
 

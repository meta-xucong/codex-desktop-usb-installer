+#[cfg(target_os = "windows")]
+fn merge_preserving_preferences(
+    target: &mut dyn TableLike,
+    source: &dyn TableLike,
+) -> Result<(), BridgeFailure> {
+    for (key, value) in source.iter() {
+        if key == MANAGED_MODEL_CATALOG_KEY {
+            continue;
+        }
+        match target.get_mut(key) {
+            None => {
+                target.insert(key, value.clone());
+            }
+            Some(existing) => {
+                if let (Some(dst), Some(src)) =
+                    (existing.as_table_like_mut(), value.as_table_like())
+                {
+                    merge_preserving_preferences(dst, src)?;
+                } else {
+                    // Serialize semantic values independently of comments/formatting.
+                    let left = format!("value = {}", existing);
+                    let right = format!("value = {}", value);
+                    let same = match (
+                        toml::from_str::<toml::Value>(&left),
+                        toml::from_str::<toml::Value>(&right),
+                    ) {
+                        (Ok(left), Ok(right)) => left == right,
+                        _ => existing.to_string().trim() == value.to_string().trim(),
+                    };
+                    if !same {
+                        return Err(BridgeFailure::new("provider-config-conflict"));
+                    }
+                }
+            }
+        }
+    }
+    Ok(())
+}
+
+#[cfg(target_os = "windows")]
+fn provider_with_selected_model(
+    provider: &Provider,
+    source_config: Option<&str>,
+    requested_model: &str,
+) -> Result<Provider, BridgeFailure> {
+    let mut updated = provider.clone();
+    let settings = updated
+        .settings_config
+        .as_object_mut()
+        .ok_or_else(|| BridgeFailure::new("provider-config-invalid"))?;
+    let provider_config = settings
+        .get("config")
+        .and_then(Value::as_str)
+        .map(str::to_owned)
+        .ok_or_else(|| BridgeFailure::new("provider-config-invalid"))?;
+    let config = source_config.unwrap_or(provider_config.as_str());
+    let mut document = config
+        .parse::<DocumentMut>()
+        .map_err(|_| BridgeFailure::new("provider-config-invalid"))?;
+    validate_catalog_keys(&document, true)?;
+    let mut normalized_provider_settings = provider.settings_config.clone();
+    crate::codex_config::normalize_codex_settings_config_model_provider(
+        &mut normalized_provider_settings,
+        source_config,
+    )
+    .map_err(|_| BridgeFailure::new("provider-config-invalid"))?;
+    let normalized_provider_config = normalized_provider_settings
+        .get("config")
+        .and_then(Value::as_str)
+        .ok_or_else(|| BridgeFailure::new("provider-config-invalid"))?;
+    let provider_document = normalized_provider_config
+        .parse::<DocumentMut>()
+        .map_err(|_| BridgeFailure::new("provider-config-invalid"))?;
+    validate_catalog_keys(&provider_document, true)?;
+    document.as_table_mut().remove(MANAGED_MODEL_CATALOG_KEY);
+    merge_preserving_preferences(document.as_table_mut(), provider_document.as_table())?;
+    let current_model = explicit_model(&document)?;
+    if current_model
+        .as_deref()
+        .is_some_and(|model| model != requested_model)
+    {
+        return Err(BridgeFailure::new("user-model-conflict"));
+    }
+    document["model"] = toml_edit::value(requested_model);
+    let config_text = document.to_string();
+    // The removed owned pointer must not leave an empty legacy marker block.
+    let config_text = config_text
+        .split_inclusive('\n')
+        .filter(|line| {
+            !matches!(
+                line.trim(),
+                "# BEGIN CODEX-USB-NATIVE-MODEL-CATALOG v1"
+                    | "# END CODEX-USB-NATIVE-MODEL-CATALOG v1"
+            )
+        })
+        .collect::<String>();
+    settings.insert("config".to_string(), Value::String(config_text));
+    // The manager-owned root must never become a provider DB field, even if
+    // an older record stored it outside the TOML string.
+    settings.remove(MANAGED_MODEL_CATALOG_KEY);
+    Ok(updated)
+}
+
+#[cfg(target_os = "windows")]
+fn validate_settings_catalog_keys(settings: &Map<String, Value>) -> Result<(), BridgeFailure> {
+    for (key, value) in settings {
+        if key == MANAGED_MODEL_CATALOG_KEY {
+            let path = value
+                .as_str()
+                .ok_or_else(|| BridgeFailure::new("catalog-conflict"))?;
+            validate_owned_catalog(path)?;
+            continue;
+        }
+        if is_unrelated_catalog_key(key) {
+            return Err(BridgeFailure::new("catalog-conflict"));
+        }
+    }
+    Ok(())
+}
+
+#[cfg(target_os = "windows")]
+fn validate_catalog_keys(
+    document: &DocumentMut,
+    allow_managed_catalog: bool,
+) -> Result<(), BridgeFailure> {
+    for (key, item) in document.as_table().iter() {
+        let key = key.to_string();
+        if key == MANAGED_MODEL_CATALOG_KEY {
+            if !allow_managed_catalog {
+                return Err(BridgeFailure::new("catalog-conflict"));
+            }
+            let path = item
+                .as_str()
+                .ok_or_else(|| BridgeFailure::new("catalog-conflict"))?;
+            validate_owned_catalog(path)?;
+            continue;
+        }
+        if is_unrelated_catalog_key(&key) {
+            return Err(BridgeFailure::new("catalog-conflict"));
+        }
+    }
+    Ok(())
+}
+
+fn is_unrelated_catalog_key(key: &str) -> bool {
+    let normalized = key.to_ascii_lowercase();
+    normalized == "catalog"
+        || normalized == "models"
+        || normalized == "modelcatalog"
+        || normalized == "model_catalog"
+        || normalized == "modelaliases"
+        || normalized == "model_aliases"
+        || (normalized.contains("catalog") && normalized != MANAGED_MODEL_CATALOG_KEY)
+}
+
+#[cfg(target_os = "windows")]
+fn validate_common_config_for_model(
+    state: &AppState,
+    provider: &Provider,
+    requested_model: &str,
+) -> Result<(), BridgeFailure> {
+    let Some(snippet) = state
+        .db
+        .get_config_snippet(AppType::Codex.as_str())
+        .map_err(|_| BridgeFailure::new("common-config-failed"))?
+    else {
+        return Ok(());
+    };
+    if snippet.trim().is_empty() {
+        return Ok(());
+    }
+    let document = snippet
+        .parse::<DocumentMut>()
+        .map_err(|_| BridgeFailure::new("common-config-failed"))?;
+    validate_catalog_keys(&document, true)?;
+    if provider
+        .meta
+        .as_ref()
+        .and_then(|meta| meta.common_config_enabled)
+        == Some(true)
+        && document.get("model").is_some()
+    {
+        return Err(BridgeFailure::new("common-config-conflict"));
+    }
+    if let Some(model) = explicit_model(&document)? {
+        if model.as_str() != requested_model {
+            return Err(BridgeFailure::new("common-config-conflict"));
+        }
+    }
+    if let Some(model_provider) = document
+        .get("model_provider")
+        .and_then(|item| item.as_str())
+        .map(str::trim)
+        .filter(|id| !id.is_empty())
+    {
+        let base_url = document
+            .get("model_providers")
+            .and_then(|item| item.as_table_like())
+            .and_then(|table| table.get(model_provider))
+            .and_then(|item| item.as_table_like())
+            .and_then(|table| table.get("base_url"))
+            .and_then(|item| item.as_str())
+            .map(str::trim)
+            .map(|url| url.trim_end_matches('/'));
+        if base_url != Some(crate::services::provider::USB_404TOKEN_BASE_URL) {
+            return Err(BridgeFailure::new("endpoint-mismatch"));
+        }
+    }
+    Ok(())
+}

+/// The USB 404token provider may only write live Codex settings through the
+/// Manager's verified model-selection bridge, except for its narrowly scoped
+/// startup bootstrap. Bootstrap may activate only the bound provider endpoint
+/// and credential in the USB-isolated CODEX_HOME; it never sets a model. A
+/// non-empty model in the provider database is not proof that the installed
+/// runtime can use it, so generic startup sync / Apply must remain DB-only.
+fn validate_usb_model_selection(app_type: &AppType, provider: &Provider) -> Result<(), AppError> {
+    if !matches!(app_type, AppType::Codex) || provider.id != super::USB_404TOKEN_PROVIDER_ID {
+        return Ok(());
+    }
+    let bootstrap_context = USB_404TOKEN_BOOTSTRAP_CONTEXT.with(std::cell::Cell::get);
+    if bootstrap_context && usb_bootstrap_provider_matches_managed_home(provider) {
+        return Ok(());
+    }
+    Err(AppError::Config(
+        "404token 是受验证保护的 U 盘 Provider。请在 U 盘版 Codex 管理器中选择模型并完成 Codex 原生测试后应用；当前实时配置未更改。".into()
+    ))
+}
+
+thread_local! {
+    static USB_404TOKEN_BOOTSTRAP_CONTEXT: std::cell::Cell<bool> = const { std::cell::Cell::new(false) };
+}
+
+struct Usb404tokenBootstrapContext(bool);
+
+impl Drop for Usb404tokenBootstrapContext {
+    fn drop(&mut self) {
+        USB_404TOKEN_BOOTSTRAP_CONTEXT.with(|active| active.set(self.0));
+    }
+}
+
+pub(super) fn with_usb_404token_bootstrap_context<T>(run: impl FnOnce() -> T) -> T {
+    let previous = USB_404TOKEN_BOOTSTRAP_CONTEXT.with(|active| active.replace(true));
+    let _restore = Usb404tokenBootstrapContext(previous);
+    run()
+}
+
+fn usb_bootstrap_provider_matches_managed_home(provider: &Provider) -> bool {
+    if std::env::var("CODEX_USB_CCSWITCH_MODE").ok().as_deref() != Some("usb") {
+        return false;
+    }
+    let Some(home) = std::env::var_os("CCSWITCH_USB_CODEX_HOME") else {
+        return false;
+    };
+    let home = std::path::PathBuf::from(home);
+    if !home.is_absolute() || crate::codex_config::get_codex_config_dir() != home {
+        return false;
+    }
+    let Ok(api_key) = std::env::var("CCSWITCH_404TOKEN_DEVICE_KEY") else {
+        return false;
+    };
+    if api_key.trim().is_empty()
+        || provider
+            .settings_config
+            .pointer("/auth/OPENAI_API_KEY")
+            .and_then(Value::as_str)
+            != Some(api_key.trim())
+    {
+        return false;
+    }
+    let Some(config) = provider
+        .settings_config
+        .get("config")
+        .and_then(Value::as_str)
+    else {
+        return false;
+    };
+    let Ok(config): Result<toml::Value, _> = toml::from_str(config) else {
+        return false;
+    };
+    if config.get("model").is_some()
+        || config.get("model_reasoning_effort").is_some()
+        || config.get("model_reasoning_summary").is_some()
+    {
+        return false;
+    }
+    config.get("model_provider").and_then(toml::Value::as_str) == Some("404token")
+        && config
+            .get("model_providers")
+            .and_then(|providers| providers.get("404token"))
+            .and_then(|provider| provider.get("base_url"))
+            .and_then(toml::Value::as_str)
+            .is_some_and(|base| base.trim_end_matches('/') == super::USB_404TOKEN_BASE_URL)
+}

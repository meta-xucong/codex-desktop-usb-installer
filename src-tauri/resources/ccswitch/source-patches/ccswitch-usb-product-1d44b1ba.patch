+    /// Persist the USB-bound 404TOKEN credential and activate it for Codex.
+    /// This is deliberately idempotent: every managed USB bootstrap refreshes
+    /// the credential and applies the bound endpoint, without selecting a model.
+    /// Native Code Agent verification remains separate from provider discovery.
+    ///
+    /// The key is read only from the child process environment. It is not
+    /// printed, placed in the provider catalog, or accepted from a CLI flag.
+    pub fn bootstrap_usb_404token_from_environment(state: &AppState) -> Result<bool, AppError> {
+        let _codex_guard = crate::usb_model_selection::acquire_codex_guard()?;
+        let Ok(api_key) = std::env::var(USB_404TOKEN_DEVICE_KEY_ENV) else {
+            return Ok(false);
+        };
+        let api_key = api_key.trim();
+        if api_key.is_empty() {
+            return Ok(false);
+        }
+
+        let mut provider = Self::provider_from_usb_404token_key(api_key);
+        Self::validate_provider_settings(&AppType::Codex, &provider)?;
+        Self::set_provider_live_config_managed(&mut provider, false);
+        // Persist through the USB-specific DAO so a customized endpoint is
+        // never overwritten with the bound credential.
+        for attempt in 1..=3 {
+            match state.db.prepare_usb_codex_provider(&provider) {
+                Ok(()) => break,
+                Err(AppError::Config(_)) => return Err(AppError::Config(
+                    "USB provider endpoint conflicts with its binding; existing configuration was retained".into()
+                )),
+                Err(_) => {
+                    log::warn!("USB provider preparation failed on attempt {attempt}/3");
+                    if attempt < 3 {
+                        std::thread::sleep(std::time::Duration::from_millis(250 * attempt));
+                    }
+                }
+            }
+            if attempt == 3 {
+                return Err(AppError::Message(
+                    "USB provider preparation failed; retry is available".into(),
+                ));
+            }
+        }
+
+        // Snapshot live files and both provider-selection stores. A later MCP
+        // sync/readback/ack failure must not leave a reported-failed bootstrap
+        // silently active on the new provider.
+        let snapshot = UsbCodexBootstrapSnapshot::capture(state)?;
+        let activation = (|| {
+            // Preparing the DB record alone leaves Codex on whichever provider
+            // was previously selected (often the official endpoint). The
+            // provider config intentionally has no model field.
+            live::with_usb_404token_bootstrap_context(|| {
+                Self::switch(state, AppType::Codex, USB_404TOKEN_PROVIDER_ID)
+            })?;
+            if !Self::usb_404token_live_readback_matches(state, api_key)? {
+                return Err(AppError::Config(
+                    "404TOKEN provider was saved but live Codex configuration did not verify"
+                        .into(),
+                ));
+            }
+            write_usb_404token_handoff_ack(api_key)
+        })();
+        if let Err(error) = activation {
+            let rollback_errors = snapshot.restore(state);
+            if rollback_errors.is_empty() {
+                return Err(error);
+            }
+            return Err(AppError::Message(format!(
+                "404TOKEN bootstrap failed: {error}; rollback also failed: {}",
+                rollback_errors.join("; ")
+            )));
+        }
+        Ok(true)
+    }
+
+    fn usb_404token_live_readback_matches(state: &AppState, api_key: &str) -> Result<bool, AppError> {
+        if crate::settings::get_effective_current_provider(&state.db, &AppType::Codex)?.as_deref()
+            != Some(USB_404TOKEN_PROVIDER_ID)
+        {
+            return Ok(false);
+        }
+        let live = read_live_settings(AppType::Codex)?;
+        let live_key = live
+            .pointer("/auth/OPENAI_API_KEY")
+            .and_then(Value::as_str);
+        let Some(config) = live.get("config").and_then(Value::as_str) else {
+            return Ok(false);
+        };
+        let parsed: toml::Value = match toml::from_str(config) {
+            Ok(parsed) => parsed,
+            Err(_) => return Ok(false),
+        };
+        let selected_provider = parsed.get("model_provider").and_then(toml::Value::as_str);
+        let endpoint = parsed
+            .get("model_providers")
+            .and_then(|providers| providers.get("404token"))
+            .and_then(|provider| provider.get("base_url"))
+            .and_then(toml::Value::as_str);
+        Ok(live_key == Some(api_key)
+            && selected_provider == Some("404token")
+            && endpoint.is_some_and(|value| value.trim_end_matches('/') == USB_404TOKEN_BASE_URL))
+    }

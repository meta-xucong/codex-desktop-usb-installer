+        let config_path = crate::codex_config::get_codex_config_path();
+        Ok(Self {
+            local_provider: crate::settings::get_current_provider(&AppType::Codex),
+            database_provider: state.db.get_current_provider(AppType::Codex.as_str())?,
+            auth: read_if_present(&auth_path)?,
+            config: read_if_present(&config_path)?,
+        })
+    }
+
+    fn restore(self, state: &AppState) -> Vec<String> {
+        fn restore_file(path: &std::path::Path, previous: Option<Vec<u8>>) -> Result<(), AppError> {
+            match previous {
+                Some(bytes) => crate::config::atomic_write(path, &bytes),
+                None if path.exists() => crate::config::delete_file(path),
+                None => Ok(()),
+            }
+        }
+
+        let mut errors = Vec::new();
+        let db_result = match self.database_provider.as_deref() {
+            Some(id) => state.db.set_current_provider(AppType::Codex.as_str(), id),
+            None => state.db.clear_current_provider(AppType::Codex.as_str()),
+        };
+        if let Err(error) = db_result {
+            errors.push(format!("database provider selection: {error}"));
+        }
+        if let Err(error) =
+            crate::settings::set_current_provider(&AppType::Codex, self.local_provider.as_deref())
+        {
+            errors.push(format!("local provider selection: {error}"));
+        }
+        let auth_path = crate::codex_config::get_codex_auth_path();
+        if let Err(error) = restore_file(&auth_path, self.auth) {
+            errors.push(format!("auth.json: {error}"));
+        }
+        let config_path = crate::codex_config::get_codex_config_path();
+        if let Err(error) = restore_file(&config_path, self.config) {
+            errors.push(format!("config.toml: {error}"));
+        }

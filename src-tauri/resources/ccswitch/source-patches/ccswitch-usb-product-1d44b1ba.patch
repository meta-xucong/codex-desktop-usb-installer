+    fn provider_from_usb_404token_key(api_key: &str) -> Provider {
+        let config_toml = format!(
+            r#"model_provider = "404token"
+# No automatic model selection before Code Agent verification.
+disable_response_storage = true
+
+[model_providers.404token]
+name = "404TOKEN unified-api-internal"
+base_url = "{USB_404TOKEN_BASE_URL}"
+wire_api = "responses"
+requires_openai_auth = true"#
+        );
+        let mut provider = Provider::with_id(
+            USB_404TOKEN_PROVIDER_ID.to_string(),
+            USB_404TOKEN_PROVIDER_NAME.to_string(),
+            serde_json::json!({
+                "auth": {
+                    "OPENAI_API_KEY": api_key
+                },
+                "config": config_toml
+            }),
+            Some("https://404token.xyz".to_string()),
+        );
+        provider.category = Some("aggregator".to_string());
+        provider.icon = Some("openai".to_string());
+        provider.icon_color = Some("#00A67E".to_string());
+        provider.notes = Some(
+            "USB 404TOKEN binding; one API key is authorized by unified-api-internal for the runtime model set."
+                .to_string(),
+        );
+        provider
+    }

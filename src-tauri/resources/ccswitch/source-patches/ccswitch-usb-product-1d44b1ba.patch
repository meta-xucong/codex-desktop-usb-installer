+import { describe, expect, it } from "vitest";
+import { getCodexCustomTemplate } from "../../src/config/codexTemplates";
+import { codexProviderPresets, generateThirdPartyConfig } from "../../src/config/codexProviderPresets";
+import { universalProviderPresets, createUniversalProviderFromPreset } from "../../src/config/universalProviderPresets";
+
+describe("custom Codex discovery template", () => {
+  it("does not fabricate a default model or reasoning effort", () => {
+    const { config, auth } = getCodexCustomTemplate();
+    expect(config).not.toMatch(/^model\s*=/m);
+    expect(config).not.toMatch(/^model_reasoning_effort\s*=/m);
+    expect(config).toContain('wire_api = "responses"');
+    expect(auth.OPENAI_API_KEY).toBe("");
+  });
+});
+
+
+describe("Codex provider presets do not select unverified defaults", () => {
+  it("keeps model, reasoning and context decisions out of every preset", () => {
+    for (const preset of codexProviderPresets) {
+      expect(preset.config).not.toMatch(/^model\s*=/m);
+      expect(preset.config).not.toMatch(/^model_reasoning_effort\s*=/m);
+      expect(preset.config).not.toMatch(/^model_context_window\s*=/m);
+      expect(preset.config).not.toMatch(/^model_auto_compact_token_limit\s*=/m);
+    }
+  });
+  it("omits absent/blank choices and renders only an explicit caller choice", () => {
+    expect(generateThirdPartyConfig("fixture", "https://fixture.invalid/v1")).not.toMatch(/^model\s*=/m);
+    expect(generateThirdPartyConfig("fixture", "https://fixture.invalid/v1", "  ")).not.toMatch(/^model\s*=/m);
+    const explicit = generateThirdPartyConfig("fixture", "https://fixture.invalid/v1", "vendor/model-selected");
+    expect(explicit).toContain('model = "vendor/model-selected"');
+    expect(explicit).not.toMatch(/^model_reasoning_effort\s*=/m);
+  });
+});
+
+
+describe("universal-provider Codex defaults", () => {
+  it("does not preselect a Codex model or enable its synchronization", () => {
+    for (const preset of universalProviderPresets) {
+      const provider = createUniversalProviderFromPreset(preset, "fixture", "https://fixture.invalid", "fixture-key");
+      expect(provider.apps.codex).toBe(false);
+      expect(provider.models.codex?.model).toBeUndefined();
+      expect(provider.models.codex?.reasoningEffort).toBeUndefined();
+      expect(provider.apps.claude).toBe(preset.defaultApps.claude);
+      expect(provider.apps.gemini).toBe(preset.defaultApps.gemini);
+    }
+  });
+});

+#[cfg(test)]
+mod usb_preparation_tests {
+    use super::*;
+    use serde_json::json;
+
+    fn pending() -> Provider {
+        Provider::with_id(crate::services::provider::USB_404TOKEN_PROVIDER_ID.into(), "USB fixture".into(),
+            json!({"auth":{"OPENAI_API_KEY":"fixture-new"},"config":format!(
+                r#"model_provider = "fixture"
+[model_providers.fixture]
+base_url = "{}"
+"#,
+                crate::services::provider::USB_404TOKEN_BASE_URL)}), None)
+    }
+
+    #[test]
+    fn bootstrap_rejects_non_usb_identity_and_unbound_initial_endpoint() {
+        let db = Database::memory().unwrap();
+        let mut wrong_id = pending();
+        wrong_id.id = "different-provider".into();
+        assert!(db.prepare_usb_codex_provider(&wrong_id).is_err());
+        assert!(db.get_provider_by_id(&wrong_id.id, "codex").unwrap().is_none());
+        let mut wrong_endpoint = pending();
+        wrong_endpoint.settings_config["config"] = json!(r#"model_provider = "fixture"
+[model_providers.fixture]
+base_url = "https://unbound.invalid/v1"
+"#);
+        assert!(db.prepare_usb_codex_provider(&wrong_endpoint).is_err());
+        assert!(db.get_provider_by_id(&wrong_endpoint.id, "codex").unwrap().is_none());
+        assert_eq!(db.get_current_provider("codex").unwrap(), None);
+    }
+
+    #[test]
+    fn scoped_selection_rolls_back_settings_and_current_flag_on_callback_failure() {
+        let db = Database::memory().unwrap();
+        let mut provider = pending(); provider.id = "404token-sub2api".into();
+        provider.notes = Some("user-owned-note".into());
+        db.save_provider("codex", &provider).unwrap();
+        let before = provider.settings_config.clone();
+        let mut after = before.clone(); after["config"] = json!("model = \"arbitrary/verified-model\"\n");
+        let outcome = db.apply_usb_model_selection_transaction(&before, &after, None,
+            || Err(AppError::Config("synthetic write failure".into())));
+        assert!(outcome.is_err());
+        let stored = db.get_provider_by_id(&provider.id, "codex").unwrap().unwrap();
+        assert_eq!(stored.settings_config, before);
+        assert_eq!(stored.notes, provider.notes);
+        assert_eq!(db.get_current_provider("codex").unwrap(), None);
+    }
+
+    #[test]
+    fn scoped_selection_preserves_metadata_and_rejects_stale_or_other_current_provider() {
+        let db = Database::memory().unwrap();
+        let mut provider = pending(); provider.id = "404token-sub2api".into();
+        provider.notes = Some("user-owned-note".into());
+        db.save_provider("codex", &provider).unwrap();
+        let before = provider.settings_config.clone();
+        let mut after = before.clone(); after["config"] = json!("model = \"arbitrary/verified-model\"\n");
+        assert!(db.apply_usb_model_selection_transaction(&json!({}), &after, None, || Ok(())).is_err());
+        assert!(db.apply_usb_model_selection_transaction(&before, &after, Some("different-provider"), || Ok(())).is_err());
+        db.apply_usb_model_selection_transaction(&before, &after, None, || Ok(())).unwrap();
+        let stored = db.get_provider_by_id(&provider.id, "codex").unwrap().unwrap();
+        assert_eq!(stored.settings_config, after);
+        assert_eq!(stored.notes, provider.notes);
+        assert_eq!(db.get_current_provider("codex").unwrap().as_deref(), Some(provider.id.as_str()));
+    }
+
+    #[test]
+    fn existing_usb_record_keeps_config_and_metadata_when_credential_changes() {
+        let db = Database::memory().unwrap();
+        let mut existing = pending();
+        existing.name = "User name".into();
+        existing.notes = Some("User notes".into());
+        existing.sort_index = Some(17);
+        existing.settings_config = json!({"auth":{"OPENAI_API_KEY":"fixture-old","extra":"kept"},
+            "config":format!("model = \"user-selected\"\n{}", pending().settings_config["config"].as_str().unwrap()), "custom":{"keep":true}});
+        db.save_provider("codex", &existing).unwrap();
+        db.set_current_provider("codex", &existing.id).unwrap();
+        let before = db.get_provider_by_id(&existing.id, "codex").unwrap().unwrap();
+        db.prepare_usb_codex_provider(&pending()).unwrap();
+        let after = db.get_provider_by_id(&existing.id, "codex").unwrap().unwrap();
+        let mut expected = serde_json::to_value(before).unwrap();
+        expected["settingsConfig"]["auth"]["OPENAI_API_KEY"] = json!("fixture-new");

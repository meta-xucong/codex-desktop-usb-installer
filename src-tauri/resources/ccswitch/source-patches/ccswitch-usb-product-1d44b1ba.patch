+}
+
+#[derive(Debug)]
+struct BridgeFailure {
+    code: &'static str,
+    revision: Option<String>,
+    selected_model: Option<String>,
+    config_sha256: Option<String>,
+    applied: bool,
+}
+
+impl BridgeFailure {
+    fn new(code: &'static str) -> Self {
+        Self {
+            code,
+            revision: None,
+            selected_model: None,
+            config_sha256: None,
+            applied: false,
+        }
+    }
+
+    fn from_snapshot(snapshot: &UsbModelSelectionSnapshot, code: &'static str) -> Self {
+        Self {
+            code,
+            revision: Some(snapshot.revision.clone()),
+            selected_model: snapshot.selected_model.clone(),
+            config_sha256: snapshot.live.config_sha256.clone(),
+            applied: false,
+        }
+    }
+}
+
+struct BridgeDeadline {
+    deadline: Instant,
+}
+
+impl BridgeDeadline {
+    fn new() -> Self {
+        Self {
+            deadline: Instant::now() + BRIDGE_MAX_LIFETIME,
+        }
+    }
+
+    fn check(&self) -> Result<(), BridgeFailure> {
+        if Instant::now() > self.deadline {
+            Err(BridgeFailure::new("deadline-exceeded"))
+        } else {
+            Ok(())
+        }
+    }
+}

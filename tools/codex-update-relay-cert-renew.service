[Unit]
Description=Renew the Codex update relay TLS certificate
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/opt/codex-update-relay-edge/renew-cert.sh
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/opt/codex-update-relay-edge /srv/codex-update-relay/tls
UMask=0077
TimeoutStartSec=15min
StandardOutput=journal
StandardError=journal
